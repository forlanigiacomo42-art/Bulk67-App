/* ==========================================================================
   TAB 2: MICRONUTRIENT TRACKER
   ========================================================================== */
function renderMicroTab() {
  const dayData = getDayLog(currentDate);
  
  // Sum up micros for selected date
  let accumulatedMicros = {};
  MICRO_TARGETS.forEach(m => accumulatedMicros[m.key] = 0);

  dayData.entries.forEach(entry => {
    if (entry.micros) {
      MICRO_TARGETS.forEach(m => {
        accumulatedMicros[m.key] += (entry.micros[m.key] || 0);
      });
    }
  });

  const container = document.getElementById('micro-grid-container');
  container.innerHTML = "";

  MICRO_TARGETS.forEach(m => {
    const val = accumulatedMicros[m.key] || 0;
    const pct = Math.min(100, Math.round((val / m.target) * 100));

    let badgeClass = "badge-low", badgeText = "Basso";
    if (pct >= 50 && pct < 90) { badgeClass = "badge-mid"; badgeText = "Buono"; }
    if (pct >= 90) { badgeClass = "badge-ok"; badgeText = "Ottimale"; }

    container.innerHTML += `
      <div class="micro-card" onclick="this.classList.toggle('expanded')">
        <div class="micro-top">
          <span>${m.name}</span>
          <span>${val.toFixed(1)} / ${m.target} ${m.unit} <span class="micro-badge ${badgeClass}">${badgeText}</span></span>
        </div>
        <div class="progress-track"><div class="progress-fill" style="background:var(--primary); width:${pct}%;"></div></div>
        <div class="micro-tip">💡 <strong>Consiglio Spesa:</strong> ${m.tip}</div>
      </div>
    `;
  });
}

/* ==========================================================================
   TAB 3: WORKOUT & STRETCHING
   ========================================================================== */
let currentWorkoutDay = 'Dom';
let currentExplosiveLoc = 'casa';
let currentStretchMode = 'full';
let activeWorkoutSubtab = 'pesi';

/**
 * Renders both the weights workout list and the stretching checklist
 * for the currently selected date.
 */
function renderWorkoutTab() {
  renderWorkoutExercises();
  renderStretchChecklist();
}

function switchWorkoutSubtab(sub) {
  activeWorkoutSubtab = sub;
  document.getElementById('seg-pesi').classList.toggle('active', sub === 'pesi');
  document.getElementById('seg-stretch').classList.toggle('active', sub === 'stretch');

  document.getElementById('subtab-pesi').style.display = sub === 'pesi' ? 'block' : 'none';
  document.getElementById('subtab-stretch').style.display = sub === 'stretch' ? 'block' : 'none';
  
  // Show or hide floating timer bar
  document.getElementById('floating-timer-bar').style.display = (sub === 'pesi' || isTimerRunning) ? 'flex' : 'none';
}

function selectWorkoutDay(dayKey) {
  currentWorkoutDay = dayKey;
  document.querySelectorAll('.day-pill').forEach((p, idx) => {
    p.classList.toggle('active', ['Dom', 'Lun', 'Mer', 'Ven'][idx] === dayKey);
  });

  document.getElementById('explosive-toggle-box').style.display = (dayKey === 'Ven') ? 'block' : 'none';
  renderWorkoutExercises();
}

function setExplosiveLocation(loc) {
  currentExplosiveLoc = loc;
  document.getElementById('expl-casa').classList.toggle('active', loc === 'casa');
  document.getElementById('expl-palestra').classList.toggle('active', loc === 'palestra');
  renderWorkoutExercises();
}

function renderWorkoutExercises() {
  let routineKey = currentWorkoutDay;
  if (currentWorkoutDay === 'Ven') {
    routineKey = currentExplosiveLoc === 'casa' ? 'Ven_casa' : 'Ven_palestra';
  }

  const routine = WORKOUT_ROUTINES[routineKey];
  const container = document.getElementById('exercises-list');
  container.innerHTML = "";

  const dayData = getDayLog(currentDate);
  const workoutLogs = dayData.workouts || {};

  routine.exercises.forEach(ex => {
    const exLog = workoutLogs[ex.id] || {};
    const setsCount = Number(ex.defaultSets) || 3;

    let setsHtml = "";
    for (let s = 1; s <= setsCount; s++) {
      const setKey = `s_${s}`;
      const setVal = exLog[setKey] || { kg: "", reps: ex.defaultReps, done: false };

      setsHtml += `
        <div class="set-row">
          <span class="set-num">S${s}</span>
          <input type="number" class="input-sm" placeholder="kg" value="${setVal.kg}" onchange="saveSetInput('${ex.id}', '${setKey}', 'kg', this.value)">
          <input type="text" class="input-sm" placeholder="reps" value="${setVal.reps}" onchange="saveSetInput('${ex.id}', '${setKey}', 'reps', this.value)">
          <button class="check-btn ${setVal.done ? 'done' : ''}" onclick="toggleSetDone('${ex.id}', '${setKey}')">✓</button>
        </div>
      `;
    }

    container.innerHTML += `
      <div class="exercise-card">
        <div class="ex-title">${ex.name}</div>
        <div class="ex-last">Target: ${ex.defaultSets} serie x ${ex.defaultReps}</div>
        <div class="sets-grid">${setsHtml}</div>
      </div>
    `;
  });
}

function saveSetInput(exId, setKey, field, val) {
  const dayData = getDayLog(currentDate);
  if (!dayData.workouts) dayData.workouts = {};
  if (!dayData.workouts[exId]) dayData.workouts[exId] = {};
  if (!dayData.workouts[exId][setKey]) dayData.workouts[exId][setKey] = {};

  dayData.workouts[exId][setKey][field] = val;
  saveDayLog(currentDate, dayData);
}

function toggleSetDone(exId, setKey) {
  const dayData = getDayLog(currentDate);
  if (!dayData.workouts) dayData.workouts = {};
  if (!dayData.workouts[exId]) dayData.workouts[exId] = {};
  if (!dayData.workouts[exId][setKey]) dayData.workouts[exId][setKey] = { done: false };

  dayData.workouts[exId][setKey].done = !dayData.workouts[exId][setKey].done;
  saveDayLog(currentDate, dayData);
  
  if (dayData.workouts[exId][setKey].done) {
    startRestTimer(90); // default auto rest timer trigger
  }

  renderWorkoutExercises();
}

/* Rest Timer Engine */
let timerInterval = null;
let timerSeconds = 0;
let isTimerRunning = false;

function startRestTimer(sec) {
  stopRestTimer();
  timerSeconds = sec;
  isTimerRunning = true;
  updateTimerDisplay();
  document.getElementById('floating-timer-bar').style.display = 'flex';

  timerInterval = setInterval(() => {
    if (timerSeconds > 0) {
      timerSeconds--;
      updateTimerDisplay();
    } else {
      stopRestTimer();
      playTimerBeep();
    }
  }, 1000);
}

function toggleRestTimer() {
  if (isTimerRunning) {
    clearInterval(timerInterval);
    isTimerRunning = false;
    document.getElementById('timer-toggle-btn').textContent = "▶";
  } else {
    if (timerSeconds > 0) {
      isTimerRunning = true;
      document.getElementById('timer-toggle-btn').textContent = "⏸";
      timerInterval = setInterval(() => {
        if (timerSeconds > 0) {
          timerSeconds--;
          updateTimerDisplay();
        } else {
          stopRestTimer();
          playTimerBeep();
        }
      }, 1000);
    }
  }
}

function stopRestTimer() {
  clearInterval(timerInterval);
  isTimerRunning = false;
  timerSeconds = 0;
  updateTimerDisplay();
  document.getElementById('timer-toggle-btn').textContent = "⏸";
}

function updateTimerDisplay() {
  const m = Math.floor(timerSeconds / 60);
  const s = timerSeconds % 60;
  document.getElementById('timer-time-display').textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
}

function playTimerBeep() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.type = "sine";
    osc.frequency.setValueAtTime(880, ctx.currentTime);
    gain.gain.setValueAtTime(0.3, ctx.currentTime);
    osc.start();
    osc.stop(ctx.currentTime + 0.4);
  } catch(e) {}
}

/* Stretching Checklist & Breathing Guide */
function selectStretchMode(mode) {
  currentStretchMode = mode;
  document.getElementById('stretch-full').classList.toggle('active', mode === 'full');
  document.getElementById('stretch-quick').classList.toggle('active', mode === 'quick');
  renderStretchChecklist();
}

function renderStretchChecklist() {
  const list = STRETCH_ROUTINES[currentStretchMode];
  const container = document.getElementById('stretch-checklist');
  container.innerHTML = "";

  const dayData = getDayLog(currentDate);
  const stretchDone = dayData.stretch || {};

  list.forEach((item, idx) => {
    const isDone = stretchDone[idx] || false;
    container.innerHTML += `
      <div class="logged-item" style="cursor:pointer;" onclick="toggleStretchItem(${idx})">
        <div>
          <div class="logged-item-title">${item.name}</div>
          <div class="logged-item-sub">${item.time} • ${item.desc}</div>
        </div>
        <button class="check-btn ${isDone ? 'done' : ''}">✓</button>
      </div>
    `;
  });
}

function toggleStretchItem(idx) {
  const dayData = getDayLog(currentDate);
  if (!dayData.stretch) dayData.stretch = {};
  dayData.stretch[idx] = !dayData.stretch[idx];
  saveDayLog(currentDate, dayData);
  renderStretchChecklist();
}

/* Breathing Timer */
let breathInterval = null;
let breathState = "inhale";

function toggleBreathingGuide() {
  const circleEl = document.getElementById('breath-circle-el');
  const btnEl = document.getElementById('breath-toggle-btn');
  const textEl = document.getElementById('breath-status-text');

  if (breathInterval) {
    clearInterval(breathInterval);
    breathInterval = null;
    circleEl.classList.remove('inhale');
    btnEl.textContent = "Avvia Guida Respiro";
    textEl.textContent = "Guida Respirazione (4s IN / 6s OUT)";
  } else {
    btnEl.textContent = "Pausa Respiro";
    runBreathCycle();
    breathInterval = setInterval(runBreathCycle, 10000); // 4s in + 6s out = 10s cycle
  }
}

function runBreathCycle() {
  const circleEl = document.getElementById('breath-circle-el');
  const textEl = document.getElementById('breath-status-text');

  textEl.textContent = "Inspira dal naso... (4s)";
  circleEl.classList.add('inhale');

  setTimeout(() => {
    textEl.textContent = "Espira dalla bocca... (6s)";
    circleEl.classList.remove('inhale');
  }, 4000);
}

/* ==========================================================================
   TAB 4: PROGRESSI (WEIGHT CHART & STATS)
   ========================================================================== */
function renderProgressiTab() {
  const weights = getWeightLogs().sort((a,b) => new Date(a.date) - new Date(b.date));
  const latestWeight = weights.length > 0 ? weights[weights.length - 1].weight : 61.0;

  document.getElementById('prog-curr-weight').textContent = `Attuale: ${latestWeight.toFixed(1)} kg`;
  
  // Progress Bar
  const pct = Math.min(100, Math.max(0, ((latestWeight - 61.0) / (67.0 - 61.0)) * 100));
  document.getElementById('weight-progress-bar').style.width = `${pct}%`;

  document.getElementById('weight-input-date').value = currentDate;
  document.getElementById('weight-input-val').value = latestWeight;

  renderWeightSVGChart(weights);
  calculateWeeklyStats();
}

function logWeightEntry() {
  const dateStr = document.getElementById('weight-input-date').value;
  const val = parseFloat(document.getElementById('weight-input-val').value);

  if (!dateStr || isNaN(val)) return;

  let weights = getWeightLogs().filter(w => w.date !== dateStr);
  weights.push({ date: dateStr, weight: val });
  saveWeightLogs(weights);

  renderProgressiTab();
}

function renderWeightSVGChart(weightsArr) {
  const container = document.getElementById('weight-chart-box');
  if (weightsArr.length === 0) {
    container.innerHTML = `<div style="text-align:center; color:var(--subtext); padding:40px;">Nessun dato peso presente.</div>`;
    return;
  }

  const w = 360, h = 150;
  const minW = 60.0, maxW = 68.0;

  let points = "";
  weightsArr.forEach((pt, i) => {
    const x = (i / Math.max(1, weightsArr.length - 1)) * (w - 40) + 20;
    const y = h - 20 - ((pt.weight - minW) / (maxW - minW)) * (h - 40);
    points += `${x},${y} `;
  });

  // Target 67kg Line Y
  const targetY = h - 20 - ((67.0 - minW) / (maxW - minW)) * (h - 40);

  container.innerHTML = `
    <svg viewBox="0 0 ${w} ${h}" style="width:100%; height:100%;">
      <!-- Target Goal Dash Line -->
      <line x1="10" y1="${targetY}" x2="${w-10}" y2="${targetY}" stroke="#007AFF" stroke-dasharray="4,4" stroke-width="1.5"/>
      <text x="${w-50}" y="${targetY - 4}" fill="#007AFF" font-size="10" font-weight="bold">67 kg Target</text>

      <!-- Weight Line Plot -->
      <polyline points="${points}" fill="none" stroke="#34C759" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      
      ${weightsArr.map((pt, i) => {
        const x = (i / Math.max(1, weightsArr.length - 1)) * (w - 40) + 20;
        const y = h - 20 - ((pt.weight - minW) / (maxW - minW)) * (h - 40);
        return `<circle cx="${x}" cy="${y}" r="4" fill="#34C759"/>`;
      }).join('')}
    </svg>
  `;
}

function calculateWeeklyStats() {
  const logs = getLogs();
  let workoutCount = 0;
  let stretchCount = 0;

  Object.keys(logs).forEach(dateKey => {
    const d = logs[dateKey];
    if (d.workouts && Object.keys(d.workouts).length > 0) workoutCount++;
    if (d.stretch && Object.keys(d.stretch).length > 0) stretchCount++;
  });

  document.getElementById('stat-workouts').textContent = `${workoutCount} completati`;
  document.getElementById('stat-stretch').textContent = `${stretchCount} sessioni`;
}

/* JSON Backup Export & Import */
function exportDataJSON() {
  const backup = {
    settings: settings,
    logs: getLogs(),
    weights: getWeightLogs()
  };

  const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(backup, null, 2));
  const a = document.createElement('a');
  a.setAttribute("href", dataStr);
  a.setAttribute("download", `bulk67_backup_${currentDate}.json`);
  document.body.appendChild(a);
  a.click();
  a.remove();
}

function triggerImportJSON() {
  document.getElementById('json-file-input').click();
}

function importDataJSON(event) {
  const file = event.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const data = JSON.parse(e.target.result);
      if (data.settings) localStorage.setItem('bulk67_settings', JSON.stringify(data.settings));
      if (data.logs) localStorage.setItem('bulk67_logs', JSON.stringify(data.logs));
      if (data.weights) localStorage.setItem('bulk67_weights', JSON.stringify(data.weights));

      showToast("Importazione completata! Ricaricamento...", "success");
      setTimeout(() => location.reload(), 900);
    } catch(err) {
      showToast("File JSON non valido.", "error");
    }
  };
  reader.readAsText(file);
}

