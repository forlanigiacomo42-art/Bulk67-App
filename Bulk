}

function saveSettings() {
  settings.kcal = Number(document.getElementById('set-target-kcal').value) || 2630;
  settings.prot = Number(document.getElementById('set-target-prot').value) || 122;
  settings.carb = Number(document.getElementById('set-target-carb').value) || 379;
  settings.fat = Number(document.getElementById('set-target-fat').value) || 70;
  settings.water = Number(document.getElementById('set-target-water').value) || 2500;
