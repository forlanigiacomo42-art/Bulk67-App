let activeRecipeObj = null;
let currentRecipeScale = 1.0;

function openRecipesModal() {
  document.getElementById('recipe-step-select').style.display = 'block';
  document.getElementById('recipe-step-edit').style.display = 'none';
  
  const listContainer = document.getElementById('recipes-list-container');
  listContainer.innerHTML = "";

  PRELOADED_RECIPES.forEach(rec => {
    // calculate estimated kcal
    let k = 0;
    rec.ingredients.forEach(i => {
      const dbItem = FOOD_DB[i.key];
      if (dbItem) k += (dbItem.kcal * i.grams) / 100;
    });

    listContainer.innerHTML += `
      <div class="recipe-list-item" onclick="selectRecipeToEdit('${rec.id}')">
        <div>
          <div style="font-size:14px; font-weight:700;">${rec.title}</div>
          <div style="font-size:11px; color:var(--subtext);">${rec.slot} • ${rec.ingredients.length} ingredienti</div>
        </div>
        <div style="font-size:13px; font-weight:700; color:var(--primary);">~${Math.round(k)} kcal ›</div>
      </div>
    `;
  });

  openModal('modal-recipes');
}

function selectRecipeToEdit(recId) {
  const template = PRELOADED_RECIPES.find(r => r.id === recId);
  if (!template) return;

  // Deep clone recipe object
  activeRecipeObj = JSON.parse(JSON.stringify(template));
  currentRecipeScale = 1.0;

  document.getElementById('recipe-edit-title').textContent = activeRecipeObj.title;
  document.getElementById('recipe-meal-slot').value = activeRecipeObj.slot;

  // Reset scale buttons UI
  document.querySelectorAll('.scale-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.scale-btn')[1].classList.add('active');

  renderRecipeIngredientInputs();
  
  document.getElementById('recipe-step-select').style.display = 'none';
  document.getElementById('recipe-step-edit').style.display = 'block';
}

function showRecipeStepSelect() {
  document.getElementById('recipe-step-select').style.display = 'block';
  document.getElementById('recipe-step-edit').style.display = 'none';
}

function scaleRecipeIngredients(factor) {
  if (!activeRecipeObj) return;
  
  const oldScale = currentRecipeScale;
  currentRecipeScale = factor;

  activeRecipeObj.ingredients.forEach(i => {
    i.grams = Math.round((i.grams / oldScale) * factor);
  });

  document.querySelectorAll('.scale-btn').forEach(b => b.classList.remove('active'));
  if (factor === 0.5) document.querySelectorAll('.scale-btn')[0].classList.add('active');
  if (factor === 1.0) document.querySelectorAll('.scale-btn')[1].classList.add('active');
  if (factor === 1.5) document.querySelectorAll('.scale-btn')[2].classList.add('active');

  renderRecipeIngredientInputs();
}

function renderRecipeIngredientInputs() {
  const container = document.getElementById('recipe-ingredients-editor-list');
  container.innerHTML = "";

  activeRecipeObj.ingredients.forEach((ing, idx) => {
    const food = FOOD_DB[ing.key];
    if (!food) return;

    container.innerHTML += `
      <div class="ing-row">
        <span style="font-size:13px; font-weight:600;">${food.name}</span>
        <input type="number" class="form-input" style="padding:6px; font-size:12px; text-align:center;" value="${ing.grams}" oninput="updateIngGrams(${idx}, this.value)">
        <span style="font-size:11px; color:var(--subtext);">g</span>
      </div>
    `;
  });

  updateRecipeTotalsPreview();
}

function updateRecipeTotalsPreview() {
  if (!activeRecipeObj) return;

  let totalKcal = 0, totalP = 0, totalC = 0, totalF = 0;

  activeRecipeObj.ingredients.forEach(ing => {
    const food = FOOD_DB[ing.key];
    if (!food) return;

    totalKcal += (food.kcal * ing.grams) / 100;
    totalP += (food.p * ing.grams) / 100;
    totalC += (food.c * ing.grams) / 100;
    totalF += (food.f * ing.grams) / 100;
  });

  document.getElementById('rec-live-kcal').textContent = `${Math.round(totalKcal)} kcal`;
  document.getElementById('rec-live-p').textContent = `${Math.round(totalP)}g`;
  document.getElementById('rec-live-c').textContent = `${Math.round(totalC)}g`;
  document.getElementById('rec-live-f').textContent = `${Math.round(totalF)}g`;
}

function updateIngGrams(idx, val) {
  if (!activeRecipeObj) return;
  activeRecipeObj.ingredients[idx].grams = Number(val) || 0;
  // Update totals without re-rendering inputs so typing never loses focus
  updateRecipeTotalsPreview();
}

function updateIngGrams(idx, val) {
  if (!activeRecipeObj) return;
  activeRecipeObj.ingredients[idx].grams = Number(val) || 0;
  renderRecipeIngredientInputs();
}

function confirmAddRecipeToLog() {
  if (!activeRecipeObj) return;

  let totalKcal = 0, totalP = 0, totalC = 0, totalF = 0;
  let microTotals = {};

  activeRecipeObj.ingredients.forEach(ing => {
    const food = FOOD_DB[ing.key];
    if (food) {
      const g = ing.grams;
      totalKcal += (food.kcal * g) / 100;
      totalP += (food.p * g) / 100;
      totalC += (food.c * g) / 100;
      totalF += (food.f * g) / 100;

      // Accumulate micros
      MICRO_TARGETS.forEach(m => {
        const val = (food[m.key] || 0) * (g / 100);
        microTotals[m.key] = (microTotals[m.key] || 0) + val;
      });
    }
  });

  const slot = document.getElementById('recipe-meal-slot').value;

  const logEntry = {
    title: activeRecipeObj.title,
    slot: slot,
    kcal: totalKcal,
    p: totalP,
    c: totalC,
    f: totalF,
    micros: microTotals
  };

  const dayData = getDayLog(currentDate);
  dayData.entries.push(logEntry);
  saveDayLog(currentDate, dayData);

  closeModal('modal-recipes');
  renderOggiTab();
  renderMicroTab();
}

