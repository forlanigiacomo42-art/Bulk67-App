/* ==========================================================================
   TAB 1: OGGI (DIARIO & ACQUA)
   ========================================================================== */
function renderOggiTab() {
  const dayData = getDayLog(currentDate);
  
  // Calculate Totals
  let totKcal = 0, totP = 0, totC = 0, totF = 0;
  dayData.entries.forEach(e => {
    totKcal += e.kcal;
    totP += e.p;
    totC += e.c;
    totF += e.f;
  });

  // Update Summary Ring
  document.getElementById('ring-consumed').textContent = Math.round(totKcal);
  document.getElementById('ring-target').textContent = `/ ${settings.kcal} kcal`;
  
  const remKcal = settings.kcal - Math.round(totKcal);
  document.getElementById('summary-cal-rem').textContent = remKcal >= 0 ? `${remKcal} kcal rimasti` : `${Math.abs(remKcal)} kcal in più`;

  const pctKcal = Math.min(100, Math.max(0, (totKcal / settings.kcal) * 100));
  const strokeOffset = 264 - (264 * (pctKcal / 100));
  document.getElementById('cal-ring-fill').style.strokeDashoffset = strokeOffset;

  // Update Macro Bars
  document.getElementById('prot-text').textContent = `${Math.round(totP)} / ${settings.prot}g`;
  document.getElementById('prot-bar').style.width = `${Math.min(100, (totP / settings.prot) * 100)}%`;

  document.getElementById('carb-text').textContent = `${Math.round(totC)} / ${settings.carb}g`;
  document.getElementById('carb-bar').style.width = `${Math.min(100, (totC / settings.carb) * 100)}%`;

  document.getElementById('fat-text').textContent = `${Math.round(totF)} / ${settings.fat}g`;
  document.getElementById('fat-bar').style.width = `${Math.min(100, (totF / settings.fat) * 100)}%`;

  // Update Water Tracker
  document.getElementById('water-text').textContent = `${dayData.water || 0} ml`;
  document.getElementById('water-target-label').textContent = `/ ${settings.water} ml`;
  document.getElementById('water-bar').style.width = `${Math.min(100, ((dayData.water || 0) / settings.water) * 100)}%`;

  // Render Logged Meals Grouped
  const mealsOrder = ["Colazione", "Merenda", "Pranzo", "Spuntino", "Cena"];
  const container = document.getElementById('logged-meals-container');
  container.innerHTML = "";

  mealsOrder.forEach(slot => {
    const slotEntries = dayData.entries.filter(e => e.slot === slot);
    if (slotEntries.length > 0) {
      const slotKcal = slotEntries.reduce((a, b) => a + b.kcal, 0);
      
      let html = `<div class="meal-section">
        <div class="meal-header">
          <span>${slot}</span>
          <span>${Math.round(slotKcal)} kcal</span>
        </div>`;

      slotEntries.forEach((entry, idx) => {
        const realIdx = dayData.entries.indexOf(entry);
        html += `
          <div class="logged-item">
            <div class="logged-item-info">
              <div class="logged-item-title">${entry.title}</div>
              <div class="logged-item-sub">P: ${Math.round(entry.p)}g | C: ${Math.round(entry.c)}g | F: ${Math.round(entry.f)}g</div>
            </div>
            <div class="logged-item-right">
              <div class="logged-kcal">${Math.round(entry.kcal)} kcal</div>
              <button class="del-btn" onclick="deleteLoggedEntry(${realIdx})">✕</button>
            </div>
          </div>
        `;
      });

      html += `</div>`;
      container.innerHTML += html;
    }
  });

  if (dayData.entries.length === 0) {
    container.innerHTML = `<div style="text-align:center; padding:24px; color:var(--subtext); font-size:13px;">Nessun alimento registrato oggi.<br>Usa i pulsanti sopra per aggiungere!</div>`;
  }
}

function addWater(amount) {
  const dayData = getDayLog(currentDate);
  dayData.water = Math.max(0, (dayData.water || 0) + amount);
  saveDayLog(currentDate, dayData);
  renderOggiTab();
}

function deleteLoggedEntry(idx) {
  const dayData = getDayLog(currentDate);
  dayData.entries.splice(idx, 1);
  saveDayLog(currentDate, dayData);
  renderOggiTab();
  renderMicroTab();
}

