function getLogs() {
  return JSON.parse(localStorage.getItem('bulk67_logs')) || {};
}

function saveLogs(logs) {
  localStorage.setItem('bulk67_logs', JSON.stringify(logs));
}

function getDayLog(dateStr) {
  const logs = getLogs();
  if (!logs[dateStr]) {
    logs[dateStr] = { entries: [], water: 0, workouts: {}, stretch: {} };
  }
  return logs[dateStr];
}

function saveDayLog(dateStr, dayData) {
  const logs = getLogs();
  logs[dateStr] = dayData;
  saveLogs(logs);
}

function getWeightLogs() {
  return JSON.parse(localStorage.getItem('bulk67_weights')) || [
    { date: "2026-11-01", weight: 61.0 }
  ];
