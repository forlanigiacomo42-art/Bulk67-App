<!DOCTYPE html>
<html lang="it" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>IronOS — Gym &amp; Nutrition OS</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              workout: '#2563eb', // blue-600
              nutrition: '#059669', // emerald-600
              accent: '#f59e0b', // amber-500
              purple: '#9333ea', // purple-600
              cyan: '#06b6d4', // cyan-500
              bg: '#090d16'
            }
          },
          fontFamily: {
            sans: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Display"', '"SF Pro Text"', '"Segoe UI"', 'Roboto', 'sans-serif']
          }
        }
      }
    }
  </script>

  <!-- External Libraries -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

  <style>
    /* Fixed Tap Highlight & Select CSS */
    * {
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    /* iOS Blurred Header & Nav Backdrops */
    .ios-blur {
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    /* Custom Scrollbar Hide */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Scroll Snap Wheel Utilities */
    .scroll-wheel {
      scroll-snap-type: y mandatory;
      overscroll-behavior-y: contain;
    }
    .scroll-wheel-item {
      scroll-snap-align: center;
    }

    /* Custom Number Input Spinner Hide */
    input[type=number]::-webkit-inner-spin-button, 
    input[type=number]::-webkit-outer-spin-button { 
      -webkit-appearance: none; 
      margin: 0; 
    }
    input[type=number] {
      -moz-appearance: textfield;
    }
  </style>
</head>
<body class="bg-[#090d16] text-slate-100 antialiased min-h-screen pb-24 font-sans select-none overflow-x-hidden">

  <!-- ==================== MAIN STICKY HEADER ==================== -->
  <header class="sticky top-0 z-40 bg-slate-950/80 border-b border-slate-800/80 ios-blur px-4 py-3 transition-all duration-200">
    <div class="max-w-lg mx-auto flex items-center justify-between">
      <!-- App Brand & Context Info -->
      <div class="flex items-center space-x-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 via-blue-600 to-emerald-500 flex items-center justify-center shadow-lg shadow-blue-500/20 font-black text-white text-lg tracking-wider">
          IO
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="text-base font-bold tracking-tight text-white">IronOS</h1>
            <span id="sessionStatusBadge" class="hidden text-[10px] font-semibold px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-400 border border-blue-500/30 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span> IN CORSO
            </span>
          </div>
          <p id="headerSubtext" class="text-xs font-medium text-slate-400">Gym &amp; Nutrition OS</p>
        </div>
      </div>

      <!-- Action Buttons Right (Tab Dependent) -->
      <div id="headerActions" class="flex items-center space-x-2">
        <!-- Dynamic header actions injected via JS -->
      </div>
    </div>
  </header>

  <!-- ==================== MAIN APPLICATION CONTAINER ==================== -->
  <main class="max-w-lg mx-auto px-4 pt-3 pb-8">

    <!-- ==================== TAB 1: ALLENAMENTO ==================== -->
    <section id="tab-allenamento" class="tab-content space-y-4">
      
      <!-- Sub-Tab Pill Switcher (Scheda Pesi / Mobilità & Stretching) -->
      <div class="flex p-1 bg-slate-900 border border-slate-800 rounded-2xl">
        <button id="subtab-btn-pesi" onclick="switchWorkoutSubTab('pesi')" class="flex-1 py-2 rounded-xl text-xs font-bold transition-all bg-blue-600 text-white shadow-md">
          🏋️ Scheda Pesi
        </button>
        <button id="subtab-btn-mobilita" onclick="switchWorkoutSubTab('mobilita')" class="flex-1 py-2 rounded-xl text-xs font-semibold transition-all text-slate-400 hover:text-slate-200">
          🧘 Mobilità &amp; Stretching
        </button>
      </div>

      <!-- SUBTAB CONTENT 1: SCHEDA PESI -->
      <div id="subtab-pesi-content" class="space-y-4">

        <!-- 1. READINESS & SLEEP CHECK-IN STRIP (FEATURE ADDITION 1) -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 shadow-sm">
          <div class="flex items-center justify-between cursor-pointer" onclick="toggleReadinessPanel()">
            <div class="flex items-center space-x-2.5">
              <div id="readinessBadgeIcon" class="w-8 h-8 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center justify-center font-bold text-xs">
                ⚡ 88%
              </div>
              <div>
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-bold text-slate-200">Stato di Prontezza</span>
                  <span id="readinessStatusText" class="text-[10px] text-emerald-400 font-semibold px-1.5 py-0.2 rounded bg-emerald-500/10">Eccellente</span>
                </div>
                <p id="readinessAdvice" class="text-[11px] text-slate-400">Ottimo recupero! Oggi puoi spingere al massimo.</p>
              </div>
            </div>
            <i data-lucide="chevron-down" id="readinessChevron" class="w-4 h-4 text-slate-400 transition-transform duration-200"></i>
          </div>

          <!-- Expandable Readiness Slider Inputs -->
          <div id="readinessInputs" class="hidden mt-3 pt-3 border-t border-slate-800/80 space-y-3">
            <div>
              <div class="flex justify-between text-xs text-slate-300 font-medium mb-1">
                <span>Ore di Sonno: <strong id="sleepVal" class="text-blue-400">7.5 h</strong></span>
                <span class="text-[10px] text-slate-400">Qualità riposo</span>
              </div>
              <input type="range" id="sleepSlider" min="4" max="11" step="0.5" value="7.5" oninput="updateReadinessFromInputs()" class="w-full accent-blue-500 bg-slate-800 rounded-lg h-1.5">
            </div>

            <div>
              <div class="flex justify-between text-xs text-slate-300 font-medium mb-1">
                <span>Livello Energia: <strong id="energyVal" class="text-amber-400">8/10</strong></span>
                <span class="text-[10px] text-slate-400">Percezione fisica</span>
              </div>
              <input type="range" id="energySlider" min="1" max="10" step="1" value="8" oninput="updateReadinessFromInputs()" class="w-full accent-amber-500 bg-slate-800 rounded-lg h-1.5">
            </div>

            <div>
              <div class="flex justify-between text-xs text-slate-300 font-medium mb-1">
                <span>Dolori / DOMS: <strong id="domsVal" class="text-purple-400">Lieve (2/10)</strong></span>
                <span class="text-[10px] text-slate-400">Affaticamento</span>
              </div>
              <input type="range" id="domsSlider" min="0" max="10" step="1" value="2" oninput="updateReadinessFromInputs()" class="w-full accent-purple-500 bg-slate-800 rounded-lg h-1.5">
            </div>
          </div>
        </div>

        <!-- 2. ROUTINE SELECTOR PILLS -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs text-slate-400 font-semibold px-1">
            <span>SELEZIONA SCHEDA WORKOUT</span>
            <button onclick="openRoutineManager()" class="text-blue-400 hover:text-blue-300 text-xs font-medium flex items-center gap-1">
              <i data-lucide="settings" class="w-3.5 h-3.5"></i> Gestisci
            </button>
          </div>
          <div id="routinePillsContainer" class="flex gap-2 overflow-x-auto no-scrollbar py-1">
            <!-- Dynamic Routine Pills injected via JS -->
          </div>
        </div>

        <!-- 3. LIVE WORKOUT METRICS BAR & TOOLS -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 flex items-center justify-between shadow-sm">
          <div class="flex items-center space-x-4">
            <div>
              <p class="text-[10px] uppercase tracking-wider font-semibold text-slate-400">Volume</p>
              <p id="liveVolumeText" class="text-sm font-black text-slate-100">0 kg</p>
            </div>
            <div class="w-px h-6 bg-slate-800"></div>
            <div>
              <p class="text-[10px] uppercase tracking-wider font-semibold text-slate-400">Serie Totali</p>
              <p id="liveSetsText" class="text-sm font-black text-blue-400">0</p>
            </div>
            <div class="w-px h-6 bg-slate-800"></div>
            <div>
              <p class="text-[10px] uppercase tracking-wider font-semibold text-slate-400">Stima Kcal</p>
              <p id="liveKcalText" class="text-sm font-black text-amber-400">0 kcal</p>
            </div>
          </div>

          <!-- PLATE CALCULATOR ICON BUTTON (FEATURE ADDITION 2) -->
          <button onclick="openPlateCalculatorModal()" class="flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-slate-800 border border-slate-700 text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-750 transition-colors" title="Calcolatore Dischi Bilanciere">
            <i data-lucide="disc" class="w-4 h-4 text-indigo-400"></i>
            <span class="hidden sm:inline">Dischi</span>
          </button>
        </div>

        <!-- 4. AUTO REST TIMER BAR -->
        <div id="restTimerBar" class="bg-slate-900/90 border border-slate-800 rounded-2xl p-3 flex items-center justify-between">
          <div class="flex items-center space-x-2.5">
            <div class="w-8 h-8 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center">
              <i data-lucide="timer" class="w-4 h-4"></i>
            </div>
            <div>
              <p class="text-xs font-bold text-slate-200">Recupero Automatizzato</p>
              <p id="timerDisplay" class="text-xs font-mono font-bold text-blue-400">00:00</p>
            </div>
          </div>
          <div class="flex items-center space-x-1.5">
            <button onclick="startRestTimer(60)" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-[11px] font-semibold text-slate-300 rounded-lg">60s</button>
            <button onclick="startRestTimer(90)" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-[11px] font-semibold text-slate-300 rounded-lg">90s</button>
            <button onclick="startRestTimer(120)" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-[11px] font-semibold text-slate-300 rounded-lg">2m</button>
            <button onclick="addRestTimerTime(15)" class="px-2 py-1 bg-blue-600/20 text-blue-400 border border-blue-500/30 text-[11px] font-semibold rounded-lg">+15s</button>
            <button id="autoTimerToggle" onclick="toggleAutoTimer()" class="px-2 py-1 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[11px] font-semibold rounded-lg">Auto: ON</button>
          </div>
        </div>

        <!-- 5. ACTIVE WORKOUT EXERCISES CONTAINER -->
        <div id="workoutExercisesContainer" class="space-y-4">
          <!-- Dynamic Exercise Cards injected via JS -->
        </div>

        <!-- 6. ADD EXERCISE & SAVE ROUTINE BUTTONS -->
        <div class="flex gap-2">
          <button onclick="openExercisePickerModal()" class="flex-1 py-3 bg-slate-900 border border-slate-800 hover:bg-slate-800/80 rounded-2xl text-xs font-bold text-slate-200 flex items-center justify-center gap-2 transition-all">
            <i data-lucide="plus-circle" class="w-4 h-4 text-blue-400"></i> Aggiungi Esercizio
          </button>
          <button onclick="saveCurrentAsNewRoutine()" class="px-4 py-3 bg-slate-900 border border-slate-800 hover:bg-slate-800/80 rounded-2xl text-xs font-bold text-purple-400 flex items-center justify-center gap-1.5 transition-all">
            <i data-lucide="bookmark-plus" class="w-4 h-4"></i> Salva Routine
          </button>
        </div>

        <!-- 7. SESSION NOTE CARD -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 space-y-2">
          <label class="text-xs font-bold text-slate-400 flex items-center gap-1.5">
            <i data-lucide="sticky-note" class="w-3.5 h-3.5 text-amber-400"></i> Note Sessione Allenamento
          </label>
          <textarea id="workoutSessionNote" rows="2" placeholder="Sensazioni, RPE generale, fastidi articolari..." class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-blue-500/50 resize-none"></textarea>
        </div>

        <!-- 8. COMPLETE & SAVE WORKOUT MAIN BUTTON -->
        <button onclick="completeAndSaveWorkout()" class="w-full py-3.5 bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-500 hover:to-indigo-600 text-white font-bold text-sm rounded-2xl shadow-lg shadow-blue-600/25 flex items-center justify-center gap-2 transition-all">
          <i data-lucide="check-circle-2" class="w-5 h-5"></i> Salva e Concludi Sessione
        </button>

      </div>

      <!-- SUBTAB CONTENT 2: MOBILITÀ & STRETCHING -->
      <div id="subtab-mobilita-content" class="hidden space-y-4">
        
        <!-- Stretching Presets selection -->
        <div class="grid grid-cols-2 gap-2">
          <button onclick="selectStretchingRoutine('full')" id="stretch-btn-full" class="p-3 bg-slate-900 border-2 border-blue-500 rounded-2xl text-left">
            <span class="text-xs font-bold text-white block">🧘 Completo 15 Min</span>
            <span class="text-[10px] text-slate-400">Decompressione globale</span>
          </button>
          <button onclick="selectStretchingRoutine('lampo')" id="stretch-btn-lampo" class="p-3 bg-slate-900 border border-slate-800 rounded-2xl text-left">
            <span class="text-xs font-bold text-white block">⚡ Lampo 5 Min</span>
            <span class="text-[10px] text-slate-400">Post-workout veloce</span>
          </button>
        </div>

        <!-- Guided Breathing Box -->
        <div class="bg-gradient-to-br from-slate-900 to-indigo-950/40 border border-indigo-500/30 rounded-2xl p-4 text-center space-y-3">
          <div class="flex items-center justify-center space-x-2">
            <i data-lucide="wind" class="w-4 h-4 text-indigo-400"></i>
            <span class="text-xs font-bold text-indigo-300">Respirazione Guidata Vaga (4" IN / 6" OUT)</span>
          </div>
          <div class="relative w-24 h-24 mx-auto flex items-center justify-center">
            <div id="breathingCircle" class="absolute inset-0 rounded-full bg-indigo-500/20 border-2 border-indigo-400 transition-all duration-1000 scale-75"></div>
            <span id="breathingPhaseText" class="relative text-xs font-black text-white">INSPIRA</span>
          </div>
          <p class="text-[11px] text-slate-400">Sincronizza lo stretching con l'espirazione lenta per ridurre il cortisolo.</p>
        </div>

        <!-- Stretching Exercises Checklist -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 space-y-3">
          <h3 class="text-xs font-bold text-slate-300 flex items-center gap-1.5">
            <i data-lucide="list-checks" class="w-4 h-4 text-emerald-400"></i> Esercizi Routine Selezionata
          </h3>
          <div id="stretchingListContainer" class="space-y-2">
            <!-- Dynamic stretching list items injected via JS -->
          </div>
        </div>

      </div>

    </section>

    <!-- ==================== TAB 2: CALENDARIO ==================== -->
    <section id="tab-calendario" class="tab-content hidden space-y-4">
      
      <!-- Time View Switcher (Settimana / Mese / Anno) -->
      <div class="flex items-center justify-between bg-slate-900 border border-slate-800 rounded-2xl p-1">
        <div class="flex space-x-1">
          <button onclick="switchCalendarView('week')" id="cal-view-week" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white">Settimana</button>
          <button onclick="switchCalendarView('month')" id="cal-view-month" class="px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-400">Mese</button>
          <button onclick="switchCalendarView('year')" id="cal-view-year" class="px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-400">Anno</button>
        </div>
        <!-- Legend Toggle Button -->
        <button onclick="toggleCalendarLegendModal()" class="px-2.5 py-1.5 text-xs text-slate-400 hover:text-slate-200 flex items-center gap-1 font-medium">
          <i data-lucide="palette" class="w-3.5 h-3.5"></i> Legenda
        </button>
      </div>

      <!-- Calendar Navigation Header -->
      <div class="flex items-center justify-between px-2">
        <button onclick="navigateCalendarPeriod(-1)" class="p-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white">
          <i data-lucide="chevron-left" class="w-4 h-4"></i>
        </button>
        <span id="calendarPeriodTitle" class="text-sm font-bold text-white">Novembre 2026</span>
        <button onclick="navigateCalendarPeriod(1)" class="p-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white">
          <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- Interactive Grid Container -->
      <div id="calendarGridContainer" class="bg-slate-900 border border-slate-800 rounded-2xl p-3 shadow-sm">
        <!-- Dynamic Grid injected via JS -->
      </div>

      <!-- Selected Day History Section -->
      <div class="space-y-3">
        <div class="flex items-center justify-between px-1">
          <h3 id="selectedDateHistoryTitle" class="text-xs font-bold text-slate-300">Sessioni del Giorno</h3>
          <span id="selectedDateHistoryCount" class="text-[11px] font-semibold text-slate-500">0 Allenamenti</span>
        </div>
        <div id="historyCardsContainer" class="space-y-3">
          <!-- Dynamic Workout History Cards injected via JS -->
        </div>
      </div>

    </section>

    <!-- ==================== TAB 3: PROGRESSI ==================== -->
    <section id="tab-progressi" class="tab-content hidden space-y-4">
      
      <!-- ESERCIZIO STRENGTH PROGRESS CHART -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3 shadow-sm">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <i data-lucide="line-chart" class="w-4 h-4 text-blue-400"></i>
            <h3 class="text-xs font-bold text-slate-200">Progressione Forza Esercizio</h3>
          </div>
          <!-- Exercise Select dropdown for chart -->
          <select id="chartExerciseSelect" onchange="renderStrengthChart()" class="bg-slate-950 border border-slate-800 rounded-xl px-2.5 py-1 text-xs text-blue-400 font-bold focus:outline-none">
            <!-- Options populated dynamically -->
          </select>
        </div>

        <!-- Metric toggle pills (Tutte le Serie / Media vs Picco / Volume) -->
        <div class="flex gap-1 bg-slate-950 p-1 rounded-xl border border-slate-800">
          <button onclick="setStrengthChartMode('all')" id="chart-mode-all" class="flex-1 py-1 rounded-lg text-[10px] font-bold bg-blue-600 text-white">Tutte Serie</button>
          <button onclick="setStrengthChartMode('avg_max')" id="chart-mode-avg" class="flex-1 py-1 rounded-lg text-[10px] font-semibold text-slate-400">Media vs Max</button>
          <button onclick="setStrengthChartMode('volume')" id="chart-mode-vol" class="flex-1 py-1 rounded-lg text-[10px] font-semibold text-slate-400">Volume Totale</button>
        </div>

        <!-- Chart Canvas -->
        <div class="relative h-48 w-full">
          <canvas id="strengthChartCanvas"></canvas>
        </div>

        <!-- Exercise KPIs Breakdown -->
        <div class="grid grid-cols-3 gap-2 pt-2 border-t border-slate-800/80 text-center">
          <div class="bg-slate-950/70 p-2 rounded-xl border border-slate-800">
            <p class="text-[9px] uppercase text-slate-400 font-semibold">Massimale (1RM Est.)</p>
            <p id="kpiEst1RM" class="text-xs font-black text-amber-400">-- kg</p>
          </div>
          <div class="bg-slate-950/70 p-2 rounded-xl border border-slate-800">
            <p class="text-[9px] uppercase text-slate-400 font-semibold">Max Carico Reale</p>
            <p id="kpiMaxWeight" class="text-xs font-black text-blue-400">-- kg</p>
          </div>
          <div class="bg-slate-950/70 p-2 rounded-xl border border-slate-800">
            <p class="text-[9px] uppercase text-slate-400 font-semibold">Volume Record</p>
            <p id="kpiBestVolume" class="text-xs font-black text-emerald-400">-- kg</p>
          </div>
        </div>
      </div>

      <!-- BACHECA RECORD PERSONALI PR (FEATURE ADDITION 3) -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3 shadow-sm">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <i data-lucide="trophy" class="w-4 h-4 text-amber-400"></i>
            <h3 class="text-xs font-bold text-slate-200">Bacheca Record Personali (PR)</h3>
          </div>
          <span class="text-[10px] text-amber-400 font-semibold px-2 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20">All-Time</span>
        </div>
        <div id="prBoardContainer" class="grid grid-cols-1 gap-2 max-h-48 overflow-y-auto no-scrollbar">
          <!-- Dynamic PR Records injected via JS -->
        </div>
      </div>

      <!-- MUSCLE VOLUME TRACKER (FEATURE ADDITION 4) -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3 shadow-sm">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <i data-lucide="dumbbell" class="w-4 h-4 text-purple-400"></i>
            <h3 class="text-xs font-bold text-slate-200">Volume Settimanale Muscolare</h3>
          </div>
          <span class="text-[10px] text-slate-400">Ultimi 7 Giorni</span>
        </div>
        <div id="muscleVolumeContainer" class="space-y-2">
          <!-- Dynamic Muscle Group Volume Bars injected via JS -->
        </div>
        <p class="text-[10px] text-slate-500 italic text-center">Zona ipertrofia ottimale: 10 - 20 serie valide a settimana per gruppo.</p>
      </div>

      <!-- BODY WEIGHT PROGRESS CHART -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3 shadow-sm">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <i data-lucide="scale" class="w-4 h-4 text-emerald-400"></i>
            <h3 class="text-xs font-bold text-slate-200">Andamento Peso Corporeo</h3>
          </div>
          <button onclick="openBodyProfileModal()" class="text-xs text-emerald-400 font-semibold flex items-center gap-1 hover:underline">
            <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i> Aggiorna
          </button>
        </div>

        <div class="relative h-44 w-full">
          <canvas id="weightChartCanvas"></canvas>
        </div>
      </div>

    </section>

    <!-- ==================== TAB 4: NUTRIZIONE ==================== -->
