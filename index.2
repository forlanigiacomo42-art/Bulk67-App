    function calculatePlates() {
      const barKg = parseFloat(document.getElementById('plateCalcBarType').value) || 20;
      const targetKg = parseFloat(document.getElementById('plateCalcTargetKg').value) || 20;

      let remainingWeightPerSide = (targetKg - barKg) / 2;
      const availablePlates = [25, 20, 15, 10, 5, 2.5, 1.25];
      const selectedPlates = [];

      if (remainingWeightPerSide > 0) {
        availablePlates.forEach(p => {
          while (remainingWeightPerSide >= p) {
            selectedPlates.push(p);
            remainingWeightPerSide -= p;
          }
        });
      }

      // Render Visual Plates
      const visualContainer = document.getElementById('plateVisualPerSide');
      visualContainer.innerHTML = selectedPlates.map(p => `
        <div class="w-8 h-12 rounded-lg bg-indigo-600 border border-indigo-400 text-white font-black text-[10px] flex items-center justify-center shadow-md">
          ${p}
        </div>
      `).join('');

      document.getElementById('plateSummaryText').innerText = selectedPlates.length > 0 ? selectedPlates.map(p => `${p}kg`).join(' + ') + ' per lato' : 'Solo bilanciere scarico';

      // Render Warmup Ramp Sets (50%, 70%, 85%, 100%)
      const rampContainer = document.getElementById('warmupRampContainer');
      const ramp = [
        { pct: '50%', wt: Math.round(targetKg * 0.5), reps: '8 reps' },
        { pct: '70%', wt: Math.round(targetKg * 0.7), reps: '5 reps' },
        { pct: '85%', wt: Math.round(targetKg * 0.85), reps: '3 reps' },
        { pct: '100%', wt: targetKg, reps: 'Work' }
      ];

      rampContainer.innerHTML = ramp.map(r => `
        <div class="bg-slate-900 p-2 rounded-xl border border-slate-800">
          <span class="text-[9px] text-slate-400 block">${r.pct}</span>
          <span class="font-bold text-white block">${r.wt} kg</span>
          <span class="text-[9px] text-indigo-400 font-semibold">${r.reps}</span>
        </div>
      `).join('');
    }

