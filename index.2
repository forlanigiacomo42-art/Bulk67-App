    let html5QrCodeScanner = null;

    function openBarcodeScannerModal() {
      document.getElementById('barcodeModal').classList.remove('hidden');
      if (!html5QrCodeScanner) {
        html5QrCodeScanner = new Html5Qrcode("interactiveScanner");
        html5QrCodeScanner.start({ facingMode: "environment" }, { fps: 10, qrbox: { width: 200, height: 150 } }, (decodedText) => {
          lookupEanCode(decodedText);
        }, (errorMessage) => {
          // ignore scan errors
        }).catch(err => {
          document.getElementById('interactiveScanner').innerHTML = `<p class="text-xs text-amber-400 p-4 text-center">Fotocamera non disponibile. Usa l'inserimento EAN manuale.</p>`;
        });
      }
    }

    function closeBarcodeScannerModal() {
      if (html5QrCodeScanner) {
        html5QrCodeScanner.stop().then(() => {
          html5QrCodeScanner.clear();
          html5QrCodeScanner = null;
        }).catch(() => {});
      }
      closeModal('barcodeModal');
    }

    function lookupEanCode(ean) {
      if (!ean) return;
      showToast(`Ricerca EAN ${ean} su OpenFoodFacts...`);

      fetch(`https://world.openfoodfacts.org/api/v2/product/${ean}.json`)
        .then(res => res.json())
        .then(data => {
          if (data.status === 1 && data.product) {
            const p = data.product;
            const nut = p.nutriments || {};
            const scannedFood = {
              id: 'scan_' + Date.now(),
              name: p.product_name_it || p.product_name || 'Prodotto Scansionato',
              calories: Math.round(nut['energy-kcal_100g'] || 0),
              carbs: Math.round(nut.carbohydrates_100g || 0),
              protein: Math.round(nut.proteins_100g || 0),
              fat: Math.round(nut.fat_100g || 0),
              defaultUnit: 'g'
            };

            appState.foods.push(scannedFood);
            saveStateToLocalStorage();
            closeBarcodeScannerModal();
            openPortionModal(scannedFood.id, 'pranzo');
          } else {
            showToast('Codice EAN non trovato nel database');
          }
        })
        .catch(err => {
          showToast('Errore di connessione a OpenFoodFacts');
        });
    }

