    /* ==================== 8. CALENDAR & HISTORY LOGIC ==================== */
    function switchCalendarView(view) {
      appState.calendarView = view;
      appState.calendarOffset = 0;
      ['week', 'month', 'year'].forEach(v => {
        const btn = document.getElementById(`cal-view-${v}`);
        if (!btn) return;
        btn.className = v === view
          ? 'px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white'
          : 'px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-400';
      });
      renderCalendarView();
    }

    function navigateCalendarPeriod(delta) {
      appState.calendarOffset += delta;
      renderCalendarView();
    }

    function toggleCalendarLegendModal() {
      document.getElementById('calendarLegendModal').classList.toggle('hidden');
      lucide.createIcons();
    }

    function selectCalendarDate(dateStr) {
      appState.selectedDateStr = appState.selectedDateStr === dateStr ? '' : dateStr;
      renderCalendarView();
    }

    function getRoutineDotColor(routineName) {
      const n = (routineName || '').toLowerCase();
      if (n.includes('spinta') || n.includes('push')) return 'bg-blue-500';
      if (n.includes('tirata') || n.includes('pull')) return 'bg-emerald-500';
      if (n.includes('gambe') || n.includes('leg')) return 'bg-amber-500';
      return 'bg-purple-500';
    }

    function renderCalendarView() {
      const container = document.getElementById('calendarGridContainer');
      const title = document.getElementById('calendarPeriodTitle');
      const todayStr = getTodayStr();

      // Build map of date -> workouts
      const byDate = {};
      appState.historyWorkouts.forEach(w => {
        if (!byDate[w.date]) byDate[w.date] = [];
        byDate[w.date].push(w);
      });

      const baseDate = new Date();
      if (appState.calendarView === 'week') {
        const currentDay = (baseDate.getDay() + 6) % 7; // Monday = 0
        const monday = new Date(baseDate.getFullYear(), baseDate.getMonth(), baseDate.getDate() - currentDay + (appState.calendarOffset * 7));
        const sunday = new Date(monday.getFullYear(), monday.getMonth(), monday.getDate() + 6);
        title.innerText = `${monday.toLocaleDateString('it-IT', { day: 'numeric', month: 'short' })} — ${sunday.toLocaleDateString('it-IT', { day: 'numeric', month: 'short', year: 'numeric' })}`;

        const dayLabels = ['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'];
        let html = '<div class="grid grid-cols-7 gap-1.5 text-center">';
        for (let i = 0; i < 7; i++) {
          const d = new Date(monday.getFullYear(), monday.getMonth(), monday.getDate() + i);
          const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
          const workouts = byDate[iso] || [];
          const isSelected = appState.selectedDateStr === iso;
          const isToday = iso === todayStr;
          const dots = workouts.slice(0, 3).map(w => `<span class="w-1.5 h-1.5 rounded-full ${getRoutineDotColor(w.routineName)} inline-block"></span>`).join('');
          html += `
            <button onclick="selectCalendarDate('${iso}')" class="p-2 rounded-xl border transition-all flex flex-col items-center justify-between min-h-[64px] ${isSelected ? 'bg-blue-600/20 border-blue-500' : 'bg-slate-950 border-slate-800 hover:border-slate-700'}">
              <span class="text-[10px] font-bold ${isToday ? 'text-blue-400' : 'text-slate-400'}">${dayLabels[i]}</span>
              <span class="text-xs font-black ${isToday ? 'text-blue-400 underline' : 'text-white'}">${d.getDate()}</span>
              <div class="flex gap-0.5 h-2 items-center">${dots || '<span class="w-1 h-1 rounded-full bg-slate-800"></span>'}</div>
            </button>`;
        }
        html += '</div>';
        container.innerHTML = html;
      } else if (appState.calendarView === 'month') {
        const targetMonthDate = new Date(baseDate.getFullYear(), baseDate.getMonth() + appState.calendarOffset, 1);
        const year = targetMonthDate.getFullYear();
        const month = targetMonthDate.getMonth();
        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const startOffset = (targetMonthDate.getDay() + 6) % 7;

        title.innerText = targetMonthDate.toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });
        const headers = ['L', 'M', 'M', 'G', 'V', 'S', 'D'];
        let html = `<div class="grid grid-cols-7 gap-1 text-center text-[10px] font-bold text-slate-500 mb-1.5">${headers.map(h => `<span>${h}</span>`).join('')}</div><div class="grid grid-cols-7 gap-1 text-center">`;

        for (let e = 0; e < startOffset; e++) html += '<div class="h-10"></div>';
        for (let day = 1; day <= daysInMonth; day++) {
          const iso = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
          const workouts = byDate[iso] || [];
          const isSelected = appState.selectedDateStr === iso;
          const isToday = iso === todayStr;
          const dots = workouts.slice(0, 3).map(w => `<span class="w-1.5 h-1.5 rounded-full ${getRoutineDotColor(w.routineName)} inline-block"></span>`).join('');
          html += `
            <button onclick="selectCalendarDate('${iso}')" class="h-10 rounded-xl border flex flex-col items-center justify-center gap-0.5 transition-all ${isSelected ? 'bg-blue-600/20 border-blue-500' : workouts.length ? 'bg-slate-900 border-slate-700' : 'bg-slate-950/60 border-slate-800/70'}">
              <span class="text-[11px] font-bold ${isToday ? 'text-blue-400 underline' : 'text-slate-200'}">${day}</span>
              <div class="flex gap-0.5 h-1.5 items-center">${dots}</div>
            </button>`;
        }
        html += '</div>';
        container.innerHTML = html;
      } else {
        const year = baseDate.getFullYear() + appState.calendarOffset;
        title.innerText = `Anno ${year}`;
        let html = '<div class="grid grid-cols-3 gap-2">';
        for (let m = 0; m < 12; m++) {
          const mDate = new Date(year, m, 1);
          const monthPrefix = `${year}-${String(m + 1).padStart(2, '0')}`;
          const count = appState.historyWorkouts.filter(w => (w.date || '').startsWith(monthPrefix)).length;
          const monthName = mDate.toLocaleDateString('it-IT', { month: 'short' });
          html += `
            <button onclick="openMonthFromYear(${year}, ${m})" class="p-2.5 rounded-xl bg-slate-950 border ${count > 0 ? 'border-blue-500/40' : 'border-slate-800'} text-left space-y-1 hover:border-slate-600">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-white capitalize">${monthName}</span>
                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded ${count > 0 ? 'bg-blue-500/20 text-blue-400' : 'bg-slate-900 text-slate-500'}">${count}</span>
              </div>
              <p class="text-[10px] text-slate-500">${count === 1 ? '1 sessione' : `${count} sessioni`}</p>
            </button>`;
        }
        html += '</div>';
        container.innerHTML = html;
      }

      renderHistoryCardsForSelectedDate();
    }

    function openMonthFromYear(year, monthIndex) {
      const now = new Date();
      appState.calendarView = 'month';
      appState.calendarOffset = (year - now.getFullYear()) * 12 + (monthIndex - now.getMonth());
      ['week', 'month', 'year'].forEach(v => {
        const btn = document.getElementById(`cal-view-${v}`);
        if (!btn) return;
        btn.className = v === 'month'
          ? 'px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white'
          : 'px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-400';
      });
      renderCalendarView();
    }

    function renderHistoryCardsForSelectedDate() {
      const container = document.getElementById('historyCardsContainer');
      const titleEl = document.getElementById('selectedDateHistoryTitle');
      const countEl = document.getElementById('selectedDateHistoryCount');

      const filtered = appState.selectedDateStr
        ? appState.historyWorkouts.filter(w => w.date === appState.selectedDateStr)
        : appState.historyWorkouts;

      titleEl.innerText = appState.selectedDateStr
        ? `Sessioni del ${appState.selectedDateStr}`
        : 'Tutte le Sessioni';
      countEl.innerText = `${filtered.length} ${filtered.length === 1 ? 'Allenamento' : 'Allenamenti'}`;

      if (filtered.length === 0) {
        container.innerHTML = '<p class="text-xs text-slate-500 italic text-center py-4">Nessun allenamento registrato per questa data.</p>';
        return;
      }

      container.innerHTML = filtered.map(w => `
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3 shadow-sm">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <div>
              <div class="flex items-center space-x-2">
                <h4 class="text-xs font-bold text-white">${w.routineName}</h4>
                ${w.isPR ? '<span class="text-[10px] font-black text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">🏆 RECORD PR</span>' : ''}
              </div>
              <p class="text-[10px] text-slate-400">${w.date}${w.note ? ` · ${w.note}` : ''}</p>
            </div>
            <div class="flex items-center space-x-2">
              <button onclick="openEditHistoryModal('${w.id}')" class="text-blue-400 hover:text-blue-300 text-xs font-semibold">Modifica</button>
              <button onclick="deleteHistoryWorkout('${w.id}')" class="text-slate-500 hover:text-red-400 text-xs font-medium">Elimina</button>
            </div>
          </div>

          <div class="space-y-1">
            ${w.exercises.map(e => {
              const exDef = appState.exercises.find(x => x.id === e.exerciseId);
              const exName = exDef ? exDef.name : e.exerciseId;
              const maxLoad = Math.max(0, ...e.sets.map(s => s.load || 0));
              return `
                <div class="text-xs text-slate-300 flex justify-between">
                  <span>${exName} (${e.sets.length} serie)</span>
                  <span class="font-mono text-blue-400 font-bold">${maxLoad} kg</span>
                </div>`;
            }).join('')}
          </div>
        </div>
      `).join('');
    }

    function openEditHistoryModal(workoutId) {
      const workout = appState.historyWorkouts.find(w => w.id === workoutId);
      if (!workout) return;
      appState.editingHistoryId = workoutId;
      const content = document.getElementById('editHistoryContent');
      content.innerHTML = `
        <div class="space-y-2.5 text-xs">
          <div>
            <label class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Nome Scheda</label>
            <input type="text" id="editHistRoutineName" value="${workout.routineName}" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white font-bold">
          </div>
          <div>
            <label class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Data</label>
            <input type="date" id="editHistDate" value="${workout.date}" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white font-bold">
