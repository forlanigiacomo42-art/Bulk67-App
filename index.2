    function getTodayStr() {
      const d = new Date();
      return d.toISOString().split('T')[0];
    }

    function initTodayLog(targetDateStr) {
      const dateKey = targetDateStr || getTodayStr();
      if (!appState.nutritionLogs[dateKey]) {
        appState.nutritionLogs[dateKey] = {
          sportHours: 1.0,
          uniHours: 4.0,
          meals: { colazione: [], pranzo: [], cena: [], spuntini: [] }
        };
      }
      if (appState.hydrationLogs[dateKey] === undefined) appState.hydrationLogs[dateKey] = dateKey === getTodayStr() ? 1750 : 0;
      if (!appState.readinessLogs[dateKey]) {
        appState.readinessLogs[dateKey] = { sleep: 7.5, energy: 8, doms: 2, score: 88 };
      }
      if (!appState.supplementLogs[dateKey]) {
        appState.supplementLogs[dateKey] = [
          { name: 'Creatina Monoidrata', dose: '5g', taken: false },
          { name: 'Vitamina D3 2000 UI', dose: '1 cp', taken: false },
          { name: 'Omega-3 (EPA/DHA)', dose: '2 cp', taken: false },
          { name: 'Magnesio Bisglicinato', dose: '400mg', taken: false }
        ];
      }
    }

    function showToast(msg) {
