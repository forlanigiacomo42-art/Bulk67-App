    function handleFoodSearch(query) {
      const container = document.getElementById('foodSearchResultsContainer');
      const q = (query || '').toLowerCase();
      let filtered = appState.foods.filter(f => f.name.toLowerCase().includes(q));
      if (appState.foodSearchFilter === 'fav') {
        filtered = filtered.filter(f => appState.favoriteFoods.includes(f.id));
      } else if (appState.foodSearchFilter === 'recent') {
        filtered = filtered.filter(f => appState.recentFoods.includes(f.id));
      }

      if (filtered.length === 0) {
        container.innerHTML = '<p class="text-xs text-slate-500 italic text-center py-6">Nessun alimento trovato.</p>';
        return;
      }

      container.innerHTML = filtered.map(f => {
        const isFav = appState.favoriteFoods.includes(f.id);
        return `
          <div onclick="openPortionModal('${f.id}', '${activePortionState.targetMeal}')" class="flex items-center justify-between p-3 bg-slate-950 border border-slate-800/80 hover:border-emerald-500/50 rounded-2xl cursor-pointer transition-all">
