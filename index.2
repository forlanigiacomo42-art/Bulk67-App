    function loadRoutineIntoActive(routineId) {
      const routine = appState.routines.find(r => r.id === routineId);
      if (!routine) return;

      appState.activeWorkout = {
        routineId: routine.id,
        routineName: routine.name,
        startTime: new Date().toISOString(),
        exercises: JSON.parse(JSON.stringify(routine.exercises))
      };
      saveStateToLocalStorage();
      renderActiveWorkoutView();
      renderHeaderActions();
      showToast(`Scheda "${routine.name}" caricata!`);
    }

    function updateSetData(exIdx, setIdx, field, value) {
      if (!appState.activeWorkout) return;
      appState.activeWorkout.exercises[exIdx].sets[setIdx][field] = parseFloat(value) || 0;
      saveStateToLocalStorage();
      updateLiveWorkoutMetrics();
    }

    function toggleSetSuperset(exIdx, setIdx) {
      if (!appState.activeWorkout) return;
      const s = appState.activeWorkout.exercises[exIdx].sets[setIdx];
      s.isSuperset = !s.isSuperset;
      saveStateToLocalStorage();
      renderActiveWorkoutView();
    }

    function toggleSetCompleted(exIdx, setIdx) {
      if (!appState.activeWorkout) return;
      const s = appState.activeWorkout.exercises[exIdx].sets[setIdx];
      s.completed = !s.completed;
      saveStateToLocalStorage();
      renderActiveWorkoutView();

      if (s.completed && appState.restTimer.autoStartOnSetCheck) {
        startRestTimer(90);
      }
    }

    function addSetToExercise(exIdx) {
      if (!appState.activeWorkout) return;
      const ex = appState.activeWorkout.exercises[exIdx];
      const lastSet = ex.sets[ex.sets.length - 1] || { targetReps: 10, repsDone: 10, load: 20, isSuperset: false };
      ex.sets.push({ ...lastSet, completed: false });
      saveStateToLocalStorage();
      renderActiveWorkoutView();
    }

    function copyPreviousSet(exIdx) {
      addSetToExercise(exIdx);
    }

    function removeExerciseFromActive(exIdx) {
      if (!appState.activeWorkout) return;
      appState.activeWorkout.exercises.splice(exIdx, 1);
      saveStateToLocalStorage();
      renderActiveWorkoutView();
    }

    function updateLiveWorkoutMetrics() {
      if (!appState.activeWorkout) {
        document.getElementById('liveVolumeText').innerText = '0 kg';
        document.getElementById('liveSetsText').innerText = '0';
        document.getElementById('liveKcalText').innerText = '0 kcal';
        return;
      }

      let totalVolume = 0;
      let totalSets = 0;

      appState.activeWorkout.exercises.forEach(ex => {
        ex.sets.forEach(set => {
          totalSets++;
          totalVolume += (set.load || 0) * (set.repsDone || 0);
        });
      });

      // Calorie burn estimation (approx 5 kcal per completed set + base volume index)
      const estKcal = Math.round(totalSets * 12 + totalVolume * 0.02);

      document.getElementById('liveVolumeText').innerText = `${totalVolume.toLocaleString('it-IT')} kg`;
      document.getElementById('liveSetsText').innerText = totalSets;
      document.getElementById('liveKcalText').innerText = `${estKcal} kcal`;
    }

    /* REST TIMER FUNCTIONS */
    function startRestTimer(seconds) {
      clearInterval(appState.restTimer.timerInterval);
      appState.restTimer.secondsLeft = seconds;
      updateRestTimerDisplay();

      appState.restTimer.timerInterval = setInterval(() => {
        appState.restTimer.secondsLeft--;
        if (appState.restTimer.secondsLeft <= 0) {
          clearInterval(appState.restTimer.timerInterval);
          appState.restTimer.secondsLeft = 0;
          showToast('⏰ Recupero Completato! Torna al Set!');
        }
        updateRestTimerDisplay();
      }, 1000);
    }

    function addRestTimerTime(sec) {
      appState.restTimer.secondsLeft += sec;
      updateRestTimerDisplay();
    }

    function toggleAutoTimer() {
      appState.restTimer.autoStartOnSetCheck = !appState.restTimer.autoStartOnSetCheck;
      const btn = document.getElementById('autoTimerToggle');
      btn.innerText = `Auto: ${appState.restTimer.autoStartOnSetCheck ? 'ON' : 'OFF'}`;
      btn.className = appState.restTimer.autoStartOnSetCheck ? 'px-2 py-1 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[11px] font-semibold rounded-lg' : 'px-2 py-1 bg-slate-800 text-slate-400 text-[11px] font-semibold rounded-lg';
    }

    function updateRestTimerDisplay() {
      const m = Math.floor(appState.restTimer.secondsLeft / 60).toString().padStart(2, '0');
      const s = (appState.restTimer.secondsLeft % 60).toString().padStart(2, '0');
      document.getElementById('timerDisplay').innerText = `${m}:${s}`;
    }

    /* PR AUTOMATIC DETECTION & WORKOUT SAVING */
    function completeAndSaveWorkout() {
      if (!appState.activeWorkout || appState.activeWorkout.exercises.length === 0) {
        showToast('Nessun allenamento attivo da salvare');
        return;
      }

      const note = document.getElementById('workoutSessionNote').value || '';
      const finishedWorkout = {
        id: 'w_' + Date.now(),
        date: getTodayStr(),
        routineName: appState.activeWorkout.routineName || 'Sessione Personalizzata',
        exercises: JSON.parse(JSON.stringify(appState.activeWorkout.exercises)),
        note: note,
        isPR: false
      };

      // PR Detection Logic (Compare max weight / estimated 1RM with history)
      let newPRsCount = 0;
      finishedWorkout.exercises.forEach(ex => {
        let currentMaxWt = 0;
        ex.sets.forEach(s => { if (s.load > currentMaxWt) currentMaxWt = s.load; });

        // Search previous max
        let prevMaxWt = 0;
        appState.historyWorkouts.forEach(hw => {
          hw.exercises.forEach(hex => {
            if (hex.exerciseId === ex.exerciseId) {
              hex.sets.forEach(hs => { if (hs.load > prevMaxWt) prevMaxWt = hs.load; });
            }
          });
        });

        if (currentMaxWt > prevMaxWt && prevMaxWt > 0) {
          ex.isPR = true;
          finishedWorkout.isPR = true;
          newPRsCount++;
        }
      });

      appState.historyWorkouts.unshift(finishedWorkout);
      appState.activeWorkout = null;
      saveStateToLocalStorage();

      renderActiveWorkoutView();
      renderHeaderActions();

      if (newPRsCount > 0) {
        showToast(`🏆 BOOM! Hai registrato ${newPRsCount} Nuovi Record Personali!`);
      } else {
        showToast('Sessione salvata con successo nel Calendario!');
      }
    }

    /* READINESS STRIP LOGIC */
    function toggleReadinessPanel() {
      const inputs = document.getElementById('readinessInputs');
      const chev = document.getElementById('readinessChevron');
      inputs.classList.toggle('hidden');
      chev.classList.toggle('rotate-180');
    }

    function updateReadinessFromInputs() {
      const sleep = parseFloat(document.getElementById('sleepSlider').value);
      const energy = parseInt(document.getElementById('energySlider').value);
      const doms = parseInt(document.getElementById('domsSlider').value);

      document.getElementById('sleepVal').innerText = `${sleep} h`;
      document.getElementById('energyVal').innerText = `${energy}/10`;
      document.getElementById('domsVal').innerText = doms === 0 ? 'Assenti' : doms <= 3 ? `Lieve (${doms}/10)` : `Elevati (${doms}/10)`;

      // Calculate Readiness Score Formula
      let score = Math.round(100 - (10 - sleep) * 6 - (10 - energy) * 5 - doms * 6);
      score = Math.max(30, Math.min(100, score));

      const badgeIcon = document.getElementById('readinessBadgeIcon');
      const statusText = document.getElementById('readinessStatusText');
      const adviceText = document.getElementById('readinessAdvice');

      badgeIcon.innerText = `⚡ ${score}%`;
      if (score >= 80) {
        statusText.innerText = 'Eccellente';
        statusText.className = 'text-[10px] text-emerald-400 font-semibold px-1.5 py-0.2 rounded bg-emerald-500/10';
        adviceText.innerText = 'Ottimo recupero! Oggi puoi spingere al massimo.';
      } else if (score >= 60) {
        statusText.innerText = 'Moderato';
        statusText.className = 'text-[10px] text-amber-400 font-semibold px-1.5 py-0.2 rounded bg-amber-500/10';
        adviceText.innerText = 'Recupero buono. Mantieni i carichi stabiliti.';
      } else {
        statusText.innerText = 'Basso';
        statusText.className = 'text-[10px] text-red-400 font-semibold px-1.5 py-0.2 rounded bg-red-500/10';
        adviceText.innerText = 'Consigliata sessione leggera o focus tecnica.';
      }

      appState.readinessLogs[getTodayStr()] = { sleep, energy, doms, score };
      saveStateToLocalStorage();
    }

    /* STRETCHING LOGIC */
    function selectStretchingRoutine(type) {
      if (type === 'full') {
        document.getElementById('stretch-btn-full').className = 'p-3 bg-slate-900 border-2 border-blue-500 rounded-2xl text-left';
        document.getElementById('stretch-btn-lampo').className = 'p-3 bg-slate-900 border border-slate-800 rounded-2xl text-left';
      } else {
        document.getElementById('stretch-btn-lampo').className = 'p-3 bg-slate-900 border-2 border-blue-500 rounded-2xl text-left';
        document.getElementById('stretch-btn-full').className = 'p-3 bg-slate-900 border border-slate-800 rounded-2xl text-left';
      }
      renderStretchingList(type);
    }

    function renderStretchingList(type = 'full') {
      const items = type === 'lampo' ? STRETCH_ITEMS.slice(0, 3) : STRETCH_ITEMS;
      const container = document.getElementById('stretchingListContainer');
      container.innerHTML = items.map((item, idx) => `
        <div class="flex items-center justify-between p-2.5 bg-slate-950 border border-slate-800 rounded-xl">
          <div class="flex items-center space-x-2.5">
            <input type="checkbox" class="w-4 h-4 accent-emerald-500 rounded cursor-pointer">
            <span class="text-xs font-semibold text-slate-200">${item.name}</span>
          </div>
          <span class="text-[11px] font-mono font-bold text-blue-400">${item.duration}</span>
        </div>
      `).join('');
    }

    function startBreathingAnimation() {
      let step = 0;
      setInterval(() => {
        const circle = document.getElementById('breathingCircle');
        const label = document.getElementById('breathingPhaseText');
        if (!circle || !label) return;
        const phase = step % 10;
        if (phase < 4) {
          label.innerText = 'INSPIRA';
          circle.classList.remove('scale-75');
          circle.classList.add('scale-100');
        } else {
          label.innerText = 'ESPIRA';
          circle.classList.remove('scale-100');
          circle.classList.add('scale-75');
        }
        step++;
      }, 1000);
    }

    /* ==================== 6. UPGRADED YAZIO DOUBLE-WHEEL SELECTOR LOGIC ==================== */
    function openPortionModal(foodId, targetMeal = 'pranzo') {
      const food = appState.foods.find(f => f.id === foodId);
      if (!food) return;

      activePortionState.food = food;
      activePortionState.targetMeal = targetMeal;
      activePortionState.cookingState = 'crudo';

      // Smart Food-Aware Ordering of Units
      const orderedUnits = getSmartOrderedUnits(food);
      
      const defaultUnitObj = orderedUnits.find(u => u.id === food.defaultUnit) || orderedUnits[0];
      activePortionState.unit = defaultUnitObj;
      activePortionState.quantity = defaultUnitObj.type === 'weight' || defaultUnitObj.type === 'volume' ? 100 : 1;

      document.getElementById('portionModalFoodName').innerText = food.name;
      document.getElementById('portionModalFoodMacrosHint').innerText = `100g = ${food.calories} kcal | C: ${food.carbs}g · P: ${food.protein}g · G: ${food.fat}g`;
      document.getElementById('portionTargetMealSelect').value = targetMeal;

      // Show or hide Crudo ↔ Cotto converter
      const crudoCottoBox = document.getElementById('crudoCottoContainer');
      const yieldNote = document.getElementById('cookingYieldNote');
      if (food.isConvertible) {
        crudoCottoBox.classList.remove('hidden');
        yieldNote.classList.remove('hidden');
        setCookingState('crudo');
      } else {
        crudoCottoBox.classList.add('hidden');
        yieldNote.classList.add('hidden');
      }

      // Render Double Wheel Options
      renderUnitWheel(orderedUnits);
      renderNumberWheelForUnit(activePortionState.unit);

      // Open Modal
      document.getElementById('foodPortionModal').classList.remove('hidden');
      syncPortionModalUI();
      lucide.createIcons();
    }

    function getSmartOrderedUnits(food) {
      const category = (food.category || '').toLowerCase();
      const name = food.name.toLowerCase();

      let topUnitIds = [];
      if (name.includes('olio') || name.includes('marmellata') || name.includes('crema') || name.includes('hummus')) {
        topUnitIds = ['cucchiaino', 'cucchiaio', 'g', 'ml'];
      } else if (category.includes('bevande') || name.includes('latte') || name.includes('albume')) {
        topUnitIds = ['ml', 'bicchiere', 'tazza', 'cl', 'L', 'g'];
      } else if (category.includes('uova') || name.includes('uovo') || name.includes('banana') || name.includes('piadina') || name.includes('cioccolato')) {
        topUnitIds = ['pezzo', 'fetta', 'quadretto', 'g', 'porzione'];
      } else {
        topUnitIds = ['g', 'cucchiaio', 'cucchiaino', 'kg', 'ml', 'porzione'];
      }

      // Reorder UNIT_DEFINITIONS putting topUnitIds first
      const topUnits = [];
      const restUnits = [];
      UNIT_DEFINITIONS.forEach(u => {
        if (topUnitIds.includes(u.id)) topUnits.push(u);
        else restUnits.push(u);
      });

      topUnits.sort((a, b) => topUnitIds.indexOf(a.id) - topUnitIds.indexOf(b.id));
      return [...topUnits, ...restUnits];
    }

    function renderUnitWheel(units) {
      const container = document.getElementById('unitWheelContainer');
      container.innerHTML = units.map((u, idx) => `
        <div onclick="selectUnitFromWheel(${idx})" class="scroll-wheel-item h-10 flex items-center px-3 space-x-2 text-xs font-bold cursor-pointer transition-colors ${idx === 0 ? 'text-emerald-400 font-black' : 'text-slate-400 hover:text-slate-200'}">
          <i data-lucide="${u.icon}" class="w-4 h-4 shrink-0"></i>
          <span class="truncate">${u.label}</span>
        </div>
      `).join('');
    }

    function renderNumberWheelForUnit(unit) {
      let nums = [];
      if (unit.id === 'g' || unit.id === 'ml' || unit.id === 'cl') {
        nums = [1, 2, 5, 10, 15, 20, 25, 30, 40, 50, 60, 75, 80, 100, 120, 150, 180, 200, 250, 300, 350, 400, 500];
      } else if (unit.id === 'kg' || unit.id === 'L') {
        nums = [0.05, 0.1, 0.2, 0.25, 0.3, 0.4, 0.5, 0.75, 1.0, 1.5, 2.0];
      } else {
        nums = [0.25, 0.5, 0.75, 1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10];
      }
      activePortionState.numberList = nums;

      const container = document.getElementById('numberWheelContainer');
      container.innerHTML = nums.map((n, idx) => {
        let displayStr = n.toString();
        if (n === 0.25) displayStr = '¼';
        if (n === 0.5) displayStr = '½';
        if (n === 0.75) displayStr = '¾';
        if (n === 1.5) displayStr = '1 ½';

        return `
          <div onclick="selectNumberFromWheel(${idx})" class="scroll-wheel-item h-10 flex items-center justify-center text-xs font-bold cursor-pointer transition-colors ${idx === 0 ? 'text-emerald-400 font-black text-sm' : 'text-slate-400 hover:text-slate-200'}">
            ${displayStr}
          </div>
        `;
      }).join('');
    }

    function selectUnitFromWheel(idx) {
      const units = getSmartOrderedUnits(activePortionState.food);
      if (!units[idx]) return;

      activePortionState.selectedUnitIndex = idx;
      activePortionState.unit = units[idx];
      renderNumberWheelForUnit(activePortionState.unit);
      
      // Update default quantity for new unit
      if (activePortionState.unit.type === 'weight' || activePortionState.unit.type === 'volume') {
        activePortionState.quantity = 100;
      } else {
        activePortionState.quantity = 1;
      }

      syncPortionModalUI();
      lucide.createIcons();
    }

    function selectNumberFromWheel(idx) {
      const num = activePortionState.numberList[idx];
      if (num !== undefined) {
        activePortionState.selectedNumberIndex = idx;
        activePortionState.quantity = num;
        syncPortionModalUI();
      }
    }

    function handleUnitWheelScroll() {
      const container = document.getElementById('unitWheelContainer');
      const itemHeight = 40;
      const idx = Math.round(container.scrollTop / itemHeight);
      const units = getSmartOrderedUnits(activePortionState.food);
      if (units[idx] && idx !== activePortionState.selectedUnitIndex) {
        selectUnitFromWheel(idx);
      }
    }

    function handleNumberWheelScroll() {
      const container = document.getElementById('numberWheelContainer');
      const itemHeight = 40;
      const idx = Math.round(container.scrollTop / itemHeight);
      if (activePortionState.numberList[idx] !== undefined && idx !== activePortionState.selectedNumberIndex) {
        selectNumberFromWheel(idx);
      }
    }

    function handleDirectInput(val) {
      activePortionState.quantity = parseFloat(val) || 0;
      syncPortionModalUI(false);
    }

    function stepQuantity(delta) {
      const u = activePortionState.unit;
      const step = u.type === 'weight' || u.type === 'volume' ? 10 : 0.5;
      activePortionState.quantity = Math.max(0, activePortionState.quantity + step * delta);
      syncPortionModalUI();
    }

    function setCookingState(state) {
      activePortionState.cookingState = state;
      const btnCrudo = document.getElementById('btnStateCrudo');
      const btnCotto = document.getElementById('btnStateCotto');
      if (state === 'crudo') {
        btnCrudo.className = 'flex-1 py-1.5 rounded-lg text-xs font-bold bg-emerald-600 text-white';
        btnCotto.className = 'flex-1 py-1.5 rounded-lg text-xs font-semibold text-slate-400';
      } else {
        btnCotto.className = 'flex-1 py-1.5 rounded-lg text-xs font-bold bg-emerald-600 text-white';
        btnCrudo.className = 'flex-1 py-1.5 rounded-lg text-xs font-semibold text-slate-400';
      }
      syncPortionModalUI();
    }

    function syncPortionModalUI(updateInput = true) {
      const f = activePortionState.food;
      const u = activePortionState.unit;
      const qty = activePortionState.quantity;

      // Calculate Gram Equiv
      let totalGrams = qty * u.gramEquiv;
      
      // If cooked, adjust for raw yield
      if (activePortionState.cookingState === 'cotto' && f.isConvertible) {
        totalGrams = totalGrams / (f.cookedYieldFactor || 1);
        document.getElementById('cookingYieldNote').innerText = `* Stima automatica: ${qty}${u.id} cotto ≈ ${Math.round(totalGrams)}g crudo.`;
      }

      // Update Yazio Header Badge
      document.getElementById('yazioBadgeUnitName').innerText = u.label;
      document.getElementById('yazioBadgeGramEquiv').innerText = `= ${u.gramEquiv} g`;
      document.getElementById('yazioBadgeGramTotal').innerText = `${Math.round(totalGrams)} g (o ml)`;

      // Update Direct Input
      if (updateInput) {
        document.getElementById('portionDirectInput').value = qty;
      }
      document.getElementById('portionDirectUnitSuffix').innerText = u.id;

      // Update Quick Chips
      const chipsContainer = document.getElementById('quickChipsContainer');
      const chipVals = u.type === 'weight' || u.type === 'volume' ? [50, 100, 150, 200, 250, 300] : [0.5, 1, 2, 3, 4];
      chipsContainer.innerHTML = chipVals.map(val => `
        <button onclick="setQuickChipQuantity(${val})" class="px-2.5 py-1 rounded-xl bg-slate-800 hover:bg-emerald-600/30 border border-slate-700 text-[11px] font-bold text-slate-300">
          ${val} ${u.id}
        </button>
      `).join('');

      // Update Visual Guide Text
      const guideText = document.getElementById('visualPortionGuideText');
      if (u.id === 'cucchiaio') guideText.innerHTML = `<strong>Guida a occhio:</strong> 1 Cucchiaio equivale alla dimensione della falange del pollice (~10g).`;
      else if (u.id === 'cucchiaino') guideText.innerHTML = `<strong>Guida a occhio:</strong> 1 Cucchiaino equivale alla punta dell'indice (~4.5g).`;
      else if (u.id === 'manciata') guideText.innerHTML = `<strong>Guida a occhio:</strong> 1 Manciata corrisponde al palmo chiuso (~30g di frutta secca).`;
      else guideText.innerHTML = `<strong>Guida a occhio:</strong> Inserimento preciso per bilancia digitale.`;
    }

    function setQuickChipQuantity(val) {
      activePortionState.quantity = val;
      syncPortionModalUI();
    }

    function confirmAddPortionToMeal() {
      const f = activePortionState.food;
      const u = activePortionState.unit;
      const qty = activePortionState.quantity;
      if (!f || !u || qty <= 0) {
        showToast('Inserisci una quantità valida');
        return;
      }

      const targetMeal = document.getElementById('portionTargetMealSelect').value || activePortionState.targetMeal || 'pranzo';
      let totalGrams = qty * u.gramEquiv;
      if (activePortionState.cookingState === 'cotto' && f.isConvertible) {
        totalGrams = totalGrams / (f.cookedYieldFactor || 1);
      }
      const factor = totalGrams / 100;

      const logEntry = {
        id: 'log_' + Date.now(),
        foodId: f.id,
        name: f.name + (activePortionState.cookingState === 'cotto' && f.isConvertible ? ' (cotto)' : ''),
        unitLabel: `${qty} ${u.id} (${Math.round(totalGrams)}g)`,
        calories: Math.round((f.calories || 0) * factor),
        carbs: +((f.carbs || 0) * factor).toFixed(1),
        protein: +((f.protein || 0) * factor).toFixed(1),
        fat: +((f.fat || 0) * factor).toFixed(1)
      };

      const today = appState.selectedDateStr || getTodayStr();
      initTodayLog(today);
      appState.nutritionLogs[today].meals[targetMeal].push(logEntry);
      appState.recentFoods = [f.id, ...appState.recentFoods.filter(id => id !== f.id)].slice(0, 10);
      saveStateToLocalStorage();

      closeModal('foodPortionModal');
      closeModal('foodLoggerModal');
      renderNutritionDiaryView();
      showToast(`Aggiunto a ${targetMeal.toUpperCase()}: ${logEntry.name}`);
    }

    /* ==================== 7. NUTRITION DIARY & SUBTABS ==================== */
    function navigateNutritionDate(delta) {
      const parts = (appState.selectedDateStr || getTodayStr()).split('-').map(Number);
      const d = new Date(parts[0], parts[1] - 1, parts[2] + delta);
      appState.selectedDateStr = d.toISOString().split('T')[0];
      initTodayLog(appState.selectedDateStr);
      renderNutritionDiaryView();
      if (appState.nutritionSubTab === 'vitamine') renderMicronutrientsView();
    }

    function updateDailyExpenditure() {
      const dateKey = appState.selectedDateStr || getTodayStr();
      initTodayLog(dateKey);
      appState.nutritionLogs[dateKey].sportHours = parseFloat(document.getElementById('sportHoursInput').value) || 0;
      appState.nutritionLogs[dateKey].uniHours = parseFloat(document.getElementById('uniHoursInput').value) || 0;
      saveStateToLocalStorage();
      renderNutritionDiaryView();
    }

    function renderNutritionDiaryView() {
      const today = appState.selectedDateStr || getTodayStr();
      initTodayLog(today);
      const dayLog = appState.nutritionLogs[today];

      // Update Date Header Display
      const dateParts = today.split('-').map(Number);
      const dateObj = new Date(dateParts[0], dateParts[1] - 1, dateParts[2]);
      const dateLabel = today === getTodayStr()
        ? `Oggi, ${dateObj.toLocaleDateString('it-IT', { day: 'numeric', month: 'short' })}`
        : dateObj.toLocaleDateString('it-IT', { weekday: 'short', day: 'numeric', month: 'short' });
      document.getElementById('nutritionDateDisplay').innerText = dateLabel;
      document.getElementById('sportHoursInput').value = dayLog.sportHours ?? 1.0;
      document.getElementById('uniHoursInput').value = dayLog.uniHours ?? 4.0;

      // Compute Total Consumed Macros
      let totalKcal = 0, totalCarbs = 0, totalProt = 0, totalFat = 0;
      Object.values(dayLog.meals).forEach(mealArray => {
        mealArray.forEach(item => {
          totalKcal += item.calories;
          totalCarbs += item.carbs;
          totalProt += item.protein;
          totalFat += item.fat;
        });
      });

      // Target Mifflin-St Jeor Formula Calculation
      const p = appState.profile;
      let bmr = (10 * p.weight) + (6.25 * p.height) - (5 * p.age) + (p.gender === 'male' ? 5 : -161);
      const extraBurn = Math.round((dayLog.sportHours * 350) + (dayLog.uniHours * 40));
      let targetKcal = Math.round(bmr * 1.35 + extraBurn);
      if (p.goal === 'surplus') targetKcal += 300;
      if (p.goal === 'deficit') targetKcal -= 400;

      const remainingKcal = targetKcal - totalKcal;

      // Dynamic Target Macros (50% C, 25% P, 25% F)
      const targetCarbs = Math.round((targetKcal * 0.50) / 4);
      const targetProt = Math.round((targetKcal * 0.25) / 4);
      const targetFat = Math.round((targetKcal * 0.25) / 9);

      // Render Ring & Macro Texts
      document.getElementById('kcalConsumedText').innerText = totalKcal;
      document.getElementById('kcalRemainingText').innerText = remainingKcal.toLocaleString('it-IT');
      document.getElementById('kcalBurnedText').innerText = extraBurn;
      document.getElementById('extraBurnCalculated').innerText = `+${extraBurn} kcal`;

      // SVG Ring Offset (stroke-dasharray = 301.59)
      const pct = Math.min(1.0, totalKcal / targetKcal);
      const offset = 301.59 * (1 - pct);
      document.getElementById('yazioProgressCircle').style.strokeDashoffset = offset;

      // Render Macro Bars
      document.getElementById('carbsMacroText').innerText = `${Math.round(totalCarbs)} / ${targetCarbs}g`;
      document.getElementById('carbsProgressBar').style.width = `${Math.min(100, (totalCarbs / targetCarbs) * 100)}%`;

      document.getElementById('proteinMacroText').innerText = `${Math.round(totalProt)} / ${targetProt}g`;
      document.getElementById('proteinProgressBar').style.width = `${Math.min(100, (totalProt / targetProt) * 100)}%`;

      document.getElementById('fatMacroText').innerText = `${Math.round(totalFat)} / ${targetFat}g`;
      document.getElementById('fatProgressBar').style.width = `${Math.min(100, (totalFat / targetFat) * 100)}%`;

      // Render 4 Meal Cards
      renderMealCards(dayLog.meals);

      // Render Hydration & Supplements
      renderHydrationCard();
      renderSupplementCard();
    }

    function renderMealCards(meals) {
      const container = document.getElementById('mealCardsContainer');
      const mealDefs = [
        { key: 'colazione', name: '☕ Colazione', icon: 'coffee' },
        { key: 'pranzo', name: '🍝 Pranzo', icon: 'utensils' },
        { key: 'cena', name: '🥩 Cena', icon: 'drumstick' },
        { key: 'spuntini', name: '🍎 Spuntini', icon: 'apple' }
      ];

      container.innerHTML = mealDefs.map(m => {
        const items = meals[m.key] || [];
        let mealKcal = 0;
        items.forEach(i => mealKcal += i.calories);

        return `
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <h4 class="text-xs font-bold text-white">${m.name}</h4>
                <span class="text-xs font-mono font-bold text-emerald-400">${mealKcal} kcal</span>
              </div>
              <div class="flex items-center space-x-1">
                <button onclick="copyMealFromYesterday('${m.key}')" class="px-2 py-1 bg-slate-800 hover:bg-slate-750 text-[10px] font-semibold text-slate-300 rounded-lg" title="Copia da Ieri">
                  Ieri
                </button>
                <button onclick="openFoodLoggerModal('${m.key}')" class="p-1.5 bg-emerald-600/20 text-emerald-400 hover:bg-emerald-600/30 rounded-lg text-xs font-bold flex items-center gap-1">
                  <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                </button>
              </div>
            </div>

            <div class="space-y-1.5">
              ${items.length === 0 ? '<p class="text-[11px] text-slate-500 italic">Nessun alimento registrato.</p>' : items.map((item, itemIdx) => `
                <div class="flex items-center justify-between p-2 bg-slate-950 border border-slate-800/80 rounded-xl">
                  <div>
                    <p class="text-xs font-bold text-slate-200">${item.name}</p>
                    <p class="text-[10px] text-slate-400">${item.unitLabel} · C:${item.carbs}g P:${item.protein}g G:${item.fat}g</p>
                  </div>
                  <div class="flex items-center space-x-2">
                    <span class="text-xs font-mono font-bold text-emerald-400">${item.calories} kcal</span>
                    <button onclick="deleteMealEntry('${m.key}', ${itemIdx})" class="text-slate-500 hover:text-red-400">
                      <i data-lucide="x" class="w-3.5 h-3.5"></i>
                    </button>
                  </div>
                </div>
              `).join('')}
            </div>
          </div>
        `;
      }).join('');
      lucide.createIcons();
    }

    function deleteMealEntry(mealKey, itemIdx) {
      const today = appState.selectedDateStr || getTodayStr();
      initTodayLog(today);
      appState.nutritionLogs[today].meals[mealKey].splice(itemIdx, 1);
      saveStateToLocalStorage();
      renderNutritionDiaryView();
    }

    function copyMealFromYesterday(mealKey) {
      const baseParts = (appState.selectedDateStr || getTodayStr()).split('-').map(Number);
      const yesterdayStr = new Date(baseParts[0], baseParts[1] - 1, baseParts[2] - 1).toISOString().split('T')[0];
      const yestLog = appState.nutritionLogs[yesterdayStr];
      if (!yestLog || !yestLog.meals[mealKey] || yestLog.meals[mealKey].length === 0) {
        showToast('Nessun pasto trovato per ieri');
        return;
      }
      const today = appState.selectedDateStr || getTodayStr();
      initTodayLog(today);
      appState.nutritionLogs[today].meals[mealKey] = JSON.parse(JSON.stringify(yestLog.meals[mealKey]));
      saveStateToLocalStorage();
      renderNutritionDiaryView();
      showToast(`Copiata ${mealKey.toUpperCase()} da Ieri!`);
    }

    function copyWholeDayFromYesterday() {
      const baseParts = (appState.selectedDateStr || getTodayStr()).split('-').map(Number);
      const yesterdayStr = new Date(baseParts[0], baseParts[1] - 1, baseParts[2] - 1).toISOString().split('T')[0];
      const yestLog = appState.nutritionLogs[yesterdayStr];
      if (!yestLog) {
        showToast('Nessuna giornata registrata ieri');
        return;
      }
      const today = appState.selectedDateStr || getTodayStr();
      initTodayLog(today);
      appState.nutritionLogs[today].meals = JSON.parse(JSON.stringify(yestLog.meals));
      saveStateToLocalStorage();
      renderNutritionDiaryView();
      showToast('Copiata l\'intera giornata nutrizionale da Ieri!');
    }

    /* HYDRATION & SUPPLEMENTS */
    function renderHydrationCard() {
      const today = appState.selectedDateStr || getTodayStr();
      initTodayLog(today);
      const currentMl = appState.hydrationLogs[today] || 0;
      const targetMl = 2500;
      document.getElementById('waterGoalText').innerText = `${currentMl} / ${targetMl} ml`;
      document.getElementById('waterProgressBar').style.width = `${Math.min(100, (currentMl / targetMl) * 100)}%`;
    }

    function addWater(ml) {
      const today = appState.selectedDateStr || getTodayStr();
      initTodayLog(today);
      appState.hydrationLogs[today] = (appState.hydrationLogs[today] || 0) + ml;
      saveStateToLocalStorage();
      renderHydrationCard();
    }

    function addCustomWater() {
      const val = parseInt(document.getElementById('customWaterInput').value) || 0;
      if (val > 0) addWater(val);
      document.getElementById('customWaterInput').value = '';
    }

    function renderSupplementCard() {
      const today = appState.selectedDateStr || getTodayStr();
      initTodayLog(today);
      const list = appState.supplementLogs[today] || [];
      const container = document.getElementById('supplementListContainer');
      container.innerHTML = list.map((item, idx) => `
        <div onclick="toggleSupplement(${idx})" class="flex items-center justify-between p-2.5 rounded-xl border cursor-pointer transition-all ${item.taken ? 'bg-purple-950/20 border-purple-500/30 text-purple-300' : 'bg-slate-950 border-slate-800 text-slate-400'}">
          <div>
            <p class="text-xs font-bold">${item.name}</p>
            <p class="text-[10px] opacity-75">${item.dose}</p>
          </div>
          <i data-lucide="${item.taken ? 'check-circle' : 'circle'}" class="w-4 h-4 shrink-0"></i>
        </div>
      `).join('');
      lucide.createIcons();
    }

    function toggleSupplement(idx) {
      const today = appState.selectedDateStr || getTodayStr();
