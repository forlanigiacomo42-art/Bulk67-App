    function renderMicronutrientsView() {
      const container = document.getElementById('micronutrientsContainer');
      if (!container) return;
      const dateKey = appState.selectedDateStr || getTodayStr();
      initTodayLog(dateKey);
      const dayLog = appState.nutritionLogs[dateKey];

      let totalKcal = 0, totalCarbs = 0, totalProt = 0, totalFat = 0;
      Object.values(dayLog.meals).forEach(arr => {
        arr.forEach(item => {
          totalKcal += item.calories || 0;
          totalCarbs += item.carbs || 0;
          totalProt += item.protein || 0;
          totalFat += item.fat || 0;
        });
      });

      const scale = totalKcal > 0 ? Math.min(1.4, totalKcal / 2200) : 0;
      const micros = [
        { name: 'Fibre Alimentari', val: Math.round(totalCarbs * 0.11), target: 30, unit: 'g', tip: 'Avena, pasta integrale, frutta, legumi' },
        { name: 'Vitamina C', val: Math.round(85 * scale), target: 105, unit: 'mg', tip: 'Agrumi, broccoli, kiwi, peperoni' },
        { name: 'Vitamina D', val: +(11 * scale).toFixed(1), target: 15, unit: 'µg', tip: 'Uova, pesce azzurro, sole' },
        { name: 'Vitamina B12', val: +(totalProt * 0.025).toFixed(1), target: 2.4, unit: 'µg', tip: 'Carne, pesce, uova, latticini' },
        { name: 'Folati (Vit. B9)', val: Math.round(310 * scale), target: 400, unit: 'µg', tip: 'Verdure a foglia verde, legumi' },
        { name: 'Calcio', val: Math.round(780 * scale), target: 1000, unit: 'mg', tip: 'Latticini, soia fortificata, mandorle' },
        { name: 'Ferro', val: +(totalProt * 0.08).toFixed(1), target: 10, unit: 'mg', tip: 'Carne rossa, legumi, avena, fondente' },
        { name: 'Magnesio', val: Math.round(290 * scale), target: 350, unit: 'mg', tip: 'Frutta secca, fondente, avena' },
        { name: 'Potassio', val: Math.round(3150 * scale), target: 3900, unit: 'mg', tip: 'Banane, patate, legumi, verdure' },
        { name: 'Zinco', val: +(totalProt * 0.09).toFixed(1), target: 12, unit: 'mg', tip: 'Carne, uova, cereali integrali' },
        { name: 'Omega-3 (EPA/DHA)', val: +(totalFat * 0.025).toFixed(2), target: 1.6, unit: 'g', tip: 'Sgombro, salmone, noci, semi di lino' },
        { name: 'Sodio (limite max)', val: Math.round(1450 * scale), target: 2000, unit: 'mg', tip: 'Evita eccessi di sale e cibi ultra-processati' }
      ];

      container.innerHTML = micros.map(m => {
        const pct = Math.min(100, Math.round((m.val / m.target) * 100));
        const barColor = pct >= 80 ? 'bg-emerald-500' : pct >= 45 ? 'bg-blue-500' : 'bg-amber-500';
        return `
          <div class="bg-slate-950 border border-slate-800 rounded-xl p-3 space-y-1.5">
            <div class="flex justify-between text-xs font-bold">
              <span class="text-slate-200">${m.name}</span>
              <span class="text-emerald-400">${m.val} / ${m.target} ${m.unit} <span class="text-slate-500 font-normal">(${pct}%)</span></span>
            </div>
            <div class="w-full bg-slate-900 rounded-full h-1.5 overflow-hidden">
              <div class="${barColor} h-full rounded-full transition-all duration-500" style="width: ${pct}%"></div>
            </div>
            <p class="text-[10px] text-slate-500">Fonti: ${m.tip}</p>
          </div>
        `;
      }).join('');
    }

    /* INTERMITTENT FASTING TIMER */
    function startFastingInterval() {
      setInterval(() => {
        const fs = appState.fastingState;
        if (!fs.isRunning || !fs.startTime) return;

        const elapsedMs = Date.now() - new Date(fs.startTime).getTime();
        const targetHours = parseInt(fs.preset.split(':')[0]);
        const targetMs = targetHours * 3600 * 1000;

        const remainingMs = Math.max(0, targetMs - elapsedMs);
        const hours = Math.floor(remainingMs / (3600 * 1000));
        const mins = Math.floor((remainingMs % (3600 * 1000)) / (60 * 1000));
        const secs = Math.floor((remainingMs % (60 * 1000)) / 1000);

        document.getElementById('fastingTimerDisplay').innerText = `${hours.toString().padStart(2, '0')}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        document.getElementById('fastingRemainingText').innerText = `Rimanenti: ${hours}h ${mins}m su ${targetHours}h`;
        
        const pct = Math.min(100, (elapsedMs / targetMs) * 100);
        document.getElementById('fastingProgressBar').style.width = `${pct}%`;
      }, 1000);
    }

    function toggleFastingTimer() {
      const fs = appState.fastingState;
      fs.isRunning = !fs.isRunning;
      if (fs.isRunning && !fs.startTime) fs.startTime = new Date().toISOString();
      saveStateToLocalStorage();
      document.getElementById('fastingStartToggleBtn').innerText = fs.isRunning ? 'PAUSA' : 'AVVIA';
    }

    function setFastingPreset(preset) {
      appState.fastingState.preset = preset;
      saveStateToLocalStorage();
      const map = { '16:8': 'fasting-btn-16', '14:10': 'fasting-btn-14', '18:6': 'fasting-btn-18' };
      Object.entries(map).forEach(([p, id]) => {
        const btn = document.getElementById(id);
        if (!btn) return;
        btn.className = p === preset
          ? 'px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-600 text-white'
          : 'px-2 py-0.5 rounded text-[10px] font-semibold text-slate-400';
      });
      showToast(`Preset Digiuno impostato a ${preset}`);
    }

