    function renderStrengthChart() {
      const exId = document.getElementById('chartExerciseSelect').value || 'ex_panca';
      const ctx = document.getElementById('strengthChartCanvas').getContext('2d');

      if (strengthChartInstance) strengthChartInstance.destroy();

      // Extract real history data for the selected exercise (fallback to demo trend if empty)
      const matching = [...appState.historyWorkouts]
        .reverse()
        .map(w => {
          const ex = w.exercises.find(e => e.exerciseId === exId);
          if (!ex || !ex.sets.length) return null;
          const loads = ex.sets.map(s => s.load || 0);
          const maxWt = Math.max(...loads);
          const avgWt = +(loads.reduce((a, b) => a + b, 0) / loads.length).toFixed(1);
          const vol = ex.sets.reduce((acc, s) => acc + (s.load || 0) * (s.repsDone || 0), 0);
          const best1RM = Math.max(...ex.sets.map(s => Math.round((s.load || 0) * (1 + (s.repsDone || 0) / 30))));
          return { date: w.date, maxWt, avgWt, vol, best1RM };
        })
        .filter(Boolean);

      const labels = matching.length ? matching.map(m => m.date.slice(5)) : ['01 Nov', '08 Nov', '15 Nov', '21 Nov'];
      const maxSeries = matching.length ? matching.map(m => m.maxWt) : [75, 77.5, 80, 82.5];
      const avgSeries = matching.length ? matching.map(m => m.avgWt) : [72, 75, 77.5, 80];
      const volSeries = matching.length ? matching.map(m => m.vol) : [1680, 1800, 1920, 2040];

      let datasets = [];
      if (appState.strengthChartMode === 'volume') {
        datasets = [{
          label: 'Volume Totale (kg)',
          data: volSeries,
          borderColor: '#10b981',
          backgroundColor: 'rgba(16, 185, 129, 0.15)',
          fill: true,
          tension: 0.3
        }];
      } else if (appState.strengthChartMode === 'avg_max') {
        datasets = [
          { label: 'Picco Max (kg)', data: maxSeries, borderColor: '#2563eb', backgroundColor: 'rgba(37, 99, 235, 0.1)', fill: false, tension: 0.3 },
          { label: 'Media Serie (kg)', data: avgSeries, borderColor: '#10b981', borderDash: [4, 4], fill: false, tension: 0.3 }
        ];
      } else {
        datasets = [{
          label: 'Carico Max (kg)',
          data: maxSeries,
          borderColor: '#2563eb',
          backgroundColor: 'rgba(37, 99, 235, 0.1)',
          fill: true,
          tension: 0.3
        }];
      }

      strengthChartInstance = new Chart(ctx, {
        type: 'line',
        data: { labels, datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: datasets.length > 1, labels: { color: '#94a3b8', font: { size: 10 } } } },
          scales: {
            x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 10 } } },
            y: { grid: { color: '#1e293b' }, ticks: { color: '#64748b', font: { size: 10 } } }
          }
        }
      });

      const best1RM = matching.length ? Math.max(...matching.map(m => m.best1RM)) : 104;
      const bestMax = Math.max(...maxSeries);
      const bestVol = Math.max(...volSeries);

      document.getElementById('kpiEst1RM').innerText = `${best1RM} kg`;
      document.getElementById('kpiMaxWeight').innerText = `${bestMax} kg`;
      document.getElementById('kpiBestVolume').innerText = `${bestVol.toLocaleString('it-IT')} kg`;
    }

