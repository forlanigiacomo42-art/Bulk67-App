    function exportCSV() {
      if (appState.historyWorkouts.length === 0) {
        showToast('Nessuna sessione da esportare in CSV');
        return;
      }
      let csv = 'Data,Scheda,Esercizio,Serie,Carico_kg,Reps_Target,Reps_Fatte\n';
      appState.historyWorkouts.forEach(w => {
        w.exercises.forEach(ex => {
          const exDef = appState.exercises.find(e => e.id === ex.exerciseId);
          const exName = (exDef ? exDef.name : ex.exerciseId).replace(/"/g, '""');
          ex.sets.forEach((s, idx) => {
            csv += `"${w.date}","${(w.routineName || '').replace(/"/g, '""')}","${exName}",${idx + 1},${s.load || 0},${s.targetReps || 0},${s.repsDone || 0}\n`;
          });
        });
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `IronOS_Workouts_${getTodayStr()}.csv`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      showToast('CSV degli allenamenti esportato!');
    }

    function exportJSONBackup() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appState, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `IronOS_Backup_${getTodayStr()}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
      showToast('Backup JSON completo scaricato!');
    }

    function importJSONBackup(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const imported = JSON.parse(e.target.result);
          appState = { ...appState, ...imported };
          saveStateToLocalStorage();
          location.reload();
        } catch (err) {
          showToast('File JSON non valido');
        }
      };
      reader.readAsText(file);
    }

    function confirmFactoryReset() {
      openCustomConfirm(
        'Reset di Fabbrica',
        'Sei sicuro di voler cancellare tutti i dati di allenamento e nutrizione?',
        () => {
          localStorage.clear();
          location.reload();
        }
      );
    }
  </script>
</body>
</html>
